rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------
    // Modelos financeiros protegidos por estas regras
    //
    // minimumWages:
    //   valor e vigência do salário mínimo, autoria e soft delete.
    // receivingAccounts:
    //   nome/observação da conta, autoria e soft delete.
    // financialAgreements:
    //   cliente, base/valor original, plano, estado de quitação e soft delete.
    // financialInstallments:
    //   acordo/cliente, sequência, vencimento, valor, pagamentos e soft delete.
    // updates com type == "Financeiro":
    //   recebimento canônico, vínculo acordo/parcela, valor, data, meio,
    //   conta, instantâneo da correção, autoria e soft delete.
    //
    // Os modelos operacionais legados abaixo mantêm as permissões anteriores
    // para não quebrar documentos históricos com esquemas heterogêneos.
    // ------------------------------------------------------------------

    // Segurança real: só usuários autenticados e ativos acessam os dados.
    // Papéis: admin (gerencia tudo) e operator (trabalho do dia a dia).
    // O e-mail abaixo é o administrador "de fábrica" (bootstrap) — também
    // definido em src/lib/constants.ts. Se mudar lá, mude aqui.
    function isSignedIn() {
      return request.auth != null;
    }

    function isBootstrapAdmin() {
      return isSignedIn() && request.auth.token.email == 'okjuridico@gmail.com';
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasProfile() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isActive() {
      return isSignedIn() &&
        (isBootstrapAdmin() || (hasProfile() && profile().active == true));
    }

    function isAdmin() {
      return isSignedIn() &&
        (isBootstrapAdmin() ||
          (hasProfile() && profile().active == true && profile().role == 'admin'));
    }

    // ------------------------------------------------------------------
    // Validadores compartilhados do domínio financeiro
    // ------------------------------------------------------------------

    function validId(value) {
      return value is string &&
        value.size() >= 1 &&
        value.size() <= 128 &&
        value.matches('^[^/]+$');
    }

    function validString(value, minSize, maxSize) {
      return value is string &&
        value.size() >= minSize &&
        value.size() <= maxSize;
    }

    function validNullableTimestamp(value) {
      return value == null || value is timestamp;
    }

    function validCents(value, allowZero) {
      return value is int &&
        value <= 100000000000000 &&
        (allowZero ? value >= 0 : value > 0);
    }

    function activeClientExists(clientId) {
      return validId(clientId) &&
        exists(/databases/$(database)/documents/clients/$(clientId)) &&
        (!get(/databases/$(database)/documents/clients/$(clientId)).data.keys()
            .hasAny(['deleted']) ||
          get(/databases/$(database)/documents/clients/$(clientId)).data.deleted != true);
    }

    function validDeletionState(data) {
      return data.deleted is bool &&
        (
          (data.deleted == false &&
            data.deletedAt == null &&
            data.deletedById == null &&
            data.deletedBy == null) ||
          (data.deleted == true &&
            data.deletedAt is timestamp &&
            validId(data.deletedById) &&
            validString(data.deletedBy, 1, 200))
        );
    }

    function validCreateAudit(data) {
      return data.createdAt == request.time &&
        data.createdById == request.auth.uid &&
        validString(data.createdBy, 1, 200) &&
        data.updatedAt == request.time &&
        data.updatedById == request.auth.uid &&
        validString(data.updatedBy, 1, 200);
    }

    function validUpdateAudit(data) {
      return data.updatedAt == request.time &&
        data.updatedById == request.auth.uid &&
        validString(data.updatedBy, 1, 200);
    }

    function onlyDeletionAndAuditChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'deleted',
        'deletedAt',
        'deletedById',
        'deletedBy',
        'updatedAt',
        'updatedById',
        'updatedBy'
      ]);
    }

    function oneIdAppended(beforeIds, afterIds, paymentId) {
      return validId(paymentId) &&
        afterIds.size() == beforeIds.size() + 1 &&
        afterIds[afterIds.size() - 1] == paymentId &&
        afterIds.toSet().size() == afterIds.size() &&
        afterIds.toSet().difference(beforeIds.toSet()).size() == 1 &&
        afterIds.toSet().difference(beforeIds.toSet()).hasOnly([paymentId]) &&
        beforeIds.toSet().difference(afterIds.toSet()).size() == 0;
    }

    function oneIdRemoved(beforeIds, afterIds) {
      return beforeIds.size() == afterIds.size() + 1 &&
        afterIds.toSet().size() == afterIds.size() &&
        beforeIds.toSet().difference(afterIds.toSet()).size() == 1 &&
        afterIds.toSet().difference(beforeIds.toSet()).size() == 0;
    }

    function validIdAt(ids, index) {
      return ids.size() <= index || validId(ids[index]);
    }

    function validInstallmentIds0To9(ids) {
      return validIdAt(ids, 0) &&
        validIdAt(ids, 1) &&
        validIdAt(ids, 2) &&
        validIdAt(ids, 3) &&
        validIdAt(ids, 4) &&
        validIdAt(ids, 5) &&
        validIdAt(ids, 6) &&
        validIdAt(ids, 7) &&
        validIdAt(ids, 8) &&
        validIdAt(ids, 9);
    }

    function validInstallmentIds10To19(ids) {
      return validIdAt(ids, 10) &&
        validIdAt(ids, 11) &&
        validIdAt(ids, 12) &&
        validIdAt(ids, 13) &&
        validIdAt(ids, 14) &&
        validIdAt(ids, 15) &&
        validIdAt(ids, 16) &&
        validIdAt(ids, 17) &&
        validIdAt(ids, 18) &&
        validIdAt(ids, 19);
    }

    function validInstallmentIds20To29(ids) {
      return validIdAt(ids, 20) &&
        validIdAt(ids, 21) &&
        validIdAt(ids, 22) &&
        validIdAt(ids, 23) &&
        validIdAt(ids, 24) &&
        validIdAt(ids, 25) &&
        validIdAt(ids, 26) &&
        validIdAt(ids, 27) &&
        validIdAt(ids, 28) &&
        validIdAt(ids, 29);
    }

    function validInstallmentIds30To39(ids) {
      return validIdAt(ids, 30) &&
        validIdAt(ids, 31) &&
        validIdAt(ids, 32) &&
        validIdAt(ids, 33) &&
        validIdAt(ids, 34) &&
        validIdAt(ids, 35) &&
        validIdAt(ids, 36) &&
        validIdAt(ids, 37) &&
        validIdAt(ids, 38) &&
        validIdAt(ids, 39);
    }

    function validInstallmentIds40To49(ids) {
      return validIdAt(ids, 40) &&
        validIdAt(ids, 41) &&
        validIdAt(ids, 42) &&
        validIdAt(ids, 43) &&
        validIdAt(ids, 44) &&
        validIdAt(ids, 45) &&
        validIdAt(ids, 46) &&
        validIdAt(ids, 47) &&
        validIdAt(ids, 48) &&
        validIdAt(ids, 49);
    }

    function validInstallmentIds50To59(ids) {
      return validIdAt(ids, 50) &&
        validIdAt(ids, 51) &&
        validIdAt(ids, 52) &&
        validIdAt(ids, 53) &&
        validIdAt(ids, 54) &&
        validIdAt(ids, 55) &&
        validIdAt(ids, 56) &&
        validIdAt(ids, 57) &&
        validIdAt(ids, 58) &&
        validIdAt(ids, 59);
    }

    function validInstallmentIds(ids, installmentCount) {
      return ids is list &&
        installmentCount is int &&
        ids.size() == installmentCount &&
        ids.size() >= 1 &&
        ids.size() <= 60 &&
        ids.toSet().size() == ids.size() &&
        validInstallmentIds0To9(ids) &&
        validInstallmentIds10To19(ids) &&
        validInstallmentIds20To29(ids) &&
        validInstallmentIds30To39(ids) &&
        validInstallmentIds40To49(ids) &&
        validInstallmentIds50To59(ids);
    }

    // ------------------------------------------------------------------
    // Salários mínimos
    // ------------------------------------------------------------------

    function validMinimumWage(data) {
      return data.keys().hasAll([
          'amountCents',
          'effectiveFrom',
          'note',
          'createdAt',
          'createdById',
          'createdBy',
          'updatedAt',
          'updatedById',
          'updatedBy',
          'deleted',
          'deletedAt',
          'deletedById',
          'deletedBy'
        ]) &&
        data.keys().hasOnly([
          'amountCents',
          'effectiveFrom',
          'note',
          'createdAt',
          'createdById',
          'createdBy',
          'updatedAt',
          'updatedById',
          'updatedBy',
          'deleted',
          'deletedAt',
          'deletedById',
          'deletedBy'
        ]) &&
        data.amountCents is int &&
        data.amountCents > 0 &&
        data.amountCents <= 1000000000 &&
        data.effectiveFrom is timestamp &&
        validString(data.note, 0, 2000) &&
        data.createdAt is timestamp &&
        validId(data.createdById) &&
        validString(data.createdBy, 1, 200) &&
        data.updatedAt is timestamp &&
        validId(data.updatedById) &&
        validString(data.updatedBy, 1, 200) &&
        validDeletionState(data);
    }

    function validMinimumWageUpdate() {
      return validMinimumWage(request.resource.data) &&
        validUpdateAudit(request.resource.data) &&
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'note',
            'updatedAt',
            'updatedById',
            'updatedBy'
          ]) ||
          onlyDeletionAndAuditChanged()
        );
    }

    match /minimumWages/{id} {
      allow read: if isActive();
      allow create: if isAdmin() &&
        validMinimumWage(request.resource.data) &&
        validCreateAudit(request.resource.data) &&
        request.resource.data.deleted == false;
      allow update: if isAdmin() && validMinimumWageUpdate();
      allow delete: if false;
    }

    // ------------------------------------------------------------------
    // Contas de recebimento
    // ------------------------------------------------------------------

    function validReceivingAccount(data) {
      return data.keys().hasAll([
          'name',
          'note',
          'createdAt',
          'createdById',
          'createdBy',
          'updatedAt',
          'updatedById',
          'updatedBy',
          'deleted',
          'deletedAt',
          'deletedById',
          'deletedBy'
        ]) &&
        data.keys().hasOnly([
          'name',
          'note',
          'createdAt',
          'createdById',
          'createdBy',
          'updatedAt',
          'updatedById',
          'updatedBy',
          'deleted',
          'deletedAt',
          'deletedById',
          'deletedBy'
        ]) &&
        validString(data.name, 1, 200) &&
        validString(data.note, 0, 2000) &&
        data.createdAt is timestamp &&
        validId(data.createdById) &&
        validString(data.createdBy, 1, 200) &&
        data.updatedAt is timestamp &&
        validId(data.updatedById) &&
        validString(data.updatedBy, 1, 200) &&
        validDeletionState(data);
    }

    function validReceivingAccountUpdate() {
      return validReceivingAccount(request.resource.data) &&
        validUpdateAudit(request.resource.data) &&
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name',
            'note',
            'updatedAt',
            'updatedById',
            'updatedBy'
          ]) ||
          onlyDeletionAndAuditChanged()
        );
    }

    match /receivingAccounts/{id} {
      allow read: if isActive();
      allow create: if isAdmin() &&
        validReceivingAccount(request.resource.data) &&
        validCreateAudit(request.resource.data) &&
        request.resource.data.deleted == false;
      allow update: if isAdmin() && validReceivingAccountUpdate();
      allow delete: if false;
    }

    // ------------------------------------------------------------------
    // Valores devidos
    // ------------------------------------------------------------------

    function validAgreementValueShape(data) {
      return (
          data.valueBasis == 'custom' &&
          data.minimumWageMultiplier == null &&
          data.baseMinimumWageRateId == null &&
          data.baseMinimumWageCents == null &&
          data.correctionPolicy == 'none'
        ) || (
          data.valueBasis in [
            'half_minimum_wage',
            'minimum_wage',
            'one_and_half_minimum_wage'
          ] &&
          data.minimumWageMultiplier is number &&
          (
            (data.valueBasis == 'half_minimum_wage' &&
              data.minimumWageMultiplier == 0.5) ||
            (data.valueBasis == 'minimum_wage' &&
              data.minimumWageMultiplier == 1) ||
            (data.valueBasis == 'one_and_half_minimum_wage' &&
              data.minimumWageMultiplier == 1.5)
          ) &&
          validId(data.baseMinimumWageRateId) &&
          validCents(data.baseMinimumWageCents, false) &&
          data.originalAmountCents >=
            data.baseMinimumWageCents * data.minimumWageMultiplier &&
          data.originalAmountCents <=
            data.baseMinimumWageCents * data.minimumWageMultiplier + 1 &&
          data.correctionPolicy == 'minimum_wage_at_closing_payment'
        );
    }

    function validAgreementPlan(data) {
      return data.paymentPlan in ['upfront', 'installments', 'at_end', 'custom'] &&
        data.installmentCount is int &&
        data.installmentCount >= 1 &&
        data.installmentCount <= 60 &&
        (
          (data.paymentPlan in ['upfront', 'at_end'] &&
            data.installmentCount == 1 &&
            data.customPaymentTerms == '') ||
          (data.paymentPlan == 'installments' &&
            data.installmentCount >= 2 &&
            data.customPaymentTerms == '') ||
          (data.paymentPlan == 'custom' &&
            validString(data.customPaymentTerms, 1, 1000))
        );
    }

    function validAgreementSettlement(data) {
      return data.settled is bool &&
        (
          (data.settled == false &&
            data.settledAt == null &&
            data.settledByPaymentId == null &&
            data.settledTargetCents == null &&
            data.settledMinimumWageRateId == null &&
            data.settledMinimumWageCents == null) ||
          (data.settled == true &&
            data.settledAt is timestamp &&
            validId(data.settledByPaymentId) &&
            validCents(data.settledTargetCents, false) &&
            data.settledTargetCents >= data.originalAmountCents &&
            (
              (data.valueBasis == 'custom' &&
                data.settledMinimumWageRateId == null &&
                data.settledMinimumWageCents == null) ||
              (data.valueBasis != 'custom' &&
                validId(data.settledMinimumWageRateId) &&
                validCents(data.settledMinimumWageCents, false))
            ))
        );
    }

    function validFinancialAgreement(data) {
      return data.keys().hasAll([
          'clientId',
          'description',
          'agreementDate',
          'valueBasis',
          'minimumWageMultiplier',
          'baseMinimumWageRateId',
          'baseMinimumWageCents',
          'originalAmountCents',
          'paymentPlan',
          'installmentCount',
          'installmentIds',
          'customPaymentTerms',
          'correctionPolicy',
          'note',
          'settled',
          'settledAt',
          'settledByPaymentId',
          'settledTargetCents',
          'settledMinimumWageRateId',
          'settledMinimumWageCents',
          'createdAt',
          'createdById',
          'createdBy',
          'updatedAt',
          'updatedById',
          'updatedBy',
          'deleted',
          'deletedAt',
          'deletedById',
          'deletedBy'
        ]) &&
        data.keys().hasOnly([
          'clientId',
          'description',
          'agreementDate',
          'valueBasis',
          'minimumWageMultiplier',
          'baseMinimumWageRateId',
          'baseMinimumWageCents',
          'originalAmountCents',
          'paymentPlan',
          'installmentCount',
          'installmentIds',
          'customPaymentTerms',
          'correctionPolicy',
          'note',
          'settled',
          'settledAt',
          'settledByPaymentId',
          'settledTargetCents',
          'settledMinimumWageRateId',
          'settledMinimumWageCents',
          'createdAt',
          'createdById',
          'createdBy',
          'updatedAt',
          'updatedById',
          'updatedBy',
          'deleted',
          'deletedAt',
          'deletedById',
          'deletedBy'
        ]) &&
        validId(data.clientId) &&
        validString(data.description, 0, 160) &&
        data.agreementDate is timestamp &&
        validCents(data.originalAmountCents, false) &&
        validAgreementValueShape(data) &&
        validAgreementPlan(data) &&
        validInstallmentIds(data.installmentIds, data.installmentCount) &&
        validString(data.note, 0, 2000) &&
        validAgreementSettlement(data) &&
        data.createdAt is timestamp &&
        validId(data.createdById) &&
        validString(data.createdBy, 1, 200) &&
        data.updatedAt is timestamp &&
        validId(data.updatedById) &&
        validString(data.updatedBy, 1, 200) &&
        validDeletionState(data);
    }

    function validAgreementWageAtCreate(data) {
      return data.valueBasis == 'custom' || (
        get(/databases/$(database)/documents/minimumWages/$(data.baseMinimumWageRateId))
          .data.deleted == false &&
        get(/databases/$(database)/documents/minimumWages/$(data.baseMinimumWageRateId))
          .data.amountCents == data.baseMinimumWageCents &&
        get(/databases/$(database)/documents/minimumWages/$(data.baseMinimumWageRateId))
          .data.effectiveFrom <= data.agreementDate
      );
    }

    function validAgreementCreate() {
      return validFinancialAgreement(request.resource.data) &&
        validCreateAudit(request.resource.data) &&
        request.resource.data.deleted == false &&
        request.resource.data.settled == false &&
        activeClientExists(request.resource.data.clientId) &&
        validAgreementWageAtCreate(request.resource.data);
    }

    function validAgreementDelete() {
      return resource.data.deleted == false &&
        resource.data.settled == false &&
        request.resource.data.deleted == true &&
        onlyDeletionAndAuditChanged() &&
        validUpdateAudit(request.resource.data);
    }

    function validAgreementRestore() {
      return isAdmin() &&
        resource.data.deleted == true &&
        request.resource.data.deleted == false &&
        onlyDeletionAndAuditChanged() &&
        validUpdateAudit(request.resource.data);
    }

    function validAgreementClosingPayment(agreementId) {
      return resource.data.settled == false &&
        request.resource.data.settled == true &&
        request.resource.data.settledAt <= request.time + duration.value(2, 'm') &&
        validId(request.resource.data.settledByPaymentId) &&
        getAfter(
          /databases/$(database)/documents/updates/$(request.resource.data.settledByPaymentId)
        ).data.type == 'Financeiro' &&
        getAfter(
          /databases/$(database)/documents/updates/$(request.resource.data.settledByPaymentId)
        ).data.deleted == false &&
        getAfter(
          /databases/$(database)/documents/updates/$(request.resource.data.settledByPaymentId)
        ).data.closesAgreement == true &&
        getAfter(
          /databases/$(database)/documents/updates/$(request.resource.data.settledByPaymentId)
        ).data.financialAgreementId == agreementId &&
        getAfter(
          /databases/$(database)/documents/updates/$(request.resource.data.settledByPaymentId)
        ).data.paidAt == request.resource.data.settledAt &&
        getAfter(
          /databases/$(database)/documents/updates/$(request.resource.data.settledByPaymentId)
        ).data.agreementTargetCentsAtPayment ==
          request.resource.data.settledTargetCents;
    }

    function validAgreementReopeningPayment(agreementId) {
      return resource.data.settled == true &&
        request.resource.data.settled == false &&
        validId(resource.data.settledByPaymentId) &&
        getAfter(
          /databases/$(database)/documents/updates/$(resource.data.settledByPaymentId)
        ).data.type == 'Financeiro' &&
        getAfter(
          /databases/$(database)/documents/updates/$(resource.data.settledByPaymentId)
        ).data.deleted == true &&
        getAfter(
          /databases/$(database)/documents/updates/$(resource.data.settledByPaymentId)
        ).data.financialAgreementId == agreementId;
    }

    function validAgreementSettlementTransition(agreementId) {
      return resource.data.deleted == false &&
        request.resource.data.deleted == false &&
        validUpdateAudit(request.resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'settled',
          'settledAt',
          'settledByPaymentId',
          'settledTargetCents',
          'settledMinimumWageRateId',
          'settledMinimumWageCents',
          'updatedAt',
          'updatedById',
          'updatedBy'
        ]) &&
        (validAgreementClosingPayment(agreementId) ||
          validAgreementReopeningPayment(agreementId));
    }

    function validAgreementClientSync() {
      return isAdmin() &&
        activeClientExists(request.resource.data.clientId) &&
        validUpdateAudit(request.resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'clientId',
          'updatedAt',
          'updatedById',
          'updatedBy'
        ]);
    }

    match /financialAgreements/{id} {
      allow read: if isActive();
      allow create: if isActive() && validAgreementCreate();
      allow update: if isActive() &&
        request.resource.data.installmentIds == resource.data.installmentIds &&
        validFinancialAgreement(request.resource.data) &&
        (
          validAgreementDelete() ||
          validAgreementRestore() ||
          validAgreementSettlementTransition(id) ||
          validAgreementClientSync()
        );
      allow delete: if false;
    }

    // ------------------------------------------------------------------
    // Parcelas
    // ------------------------------------------------------------------

    function validInstallmentSettlement(data) {
      return data.settled is bool &&
        (
          (data.settled == false &&
            data.settledAt == null &&
            data.settledByPaymentId == null &&
            data.settlementKind == null) ||
          (data.settled == true &&
            data.settledAt is timestamp &&
            validId(data.settledByPaymentId) &&
            data.settlementKind in ['full', 'partial_rolled'])
        );
    }

    function validFinancialInstallment(data) {
      return data.keys().hasAll([
          'agreementId',
          'clientId',
          'sequence',
          'installmentCount',
          'dueDate',
          'baseAmountCents',
          'paidAmountCents',
          'paymentIds',
          'settled',
          'settledAt',
          'settledByPaymentId',
          'settlementKind',
          'createdAt',
          'createdById',
          'createdBy',
          'updatedAt',
          'updatedById',
          'updatedBy',
          'deleted',
          'deletedAt',
          'deletedById',
          'deletedBy'
        ]) &&
        data.keys().hasOnly([
          'agreementId',
          'clientId',
          'sequence',
          'installmentCount',
          'dueDate',
          'baseAmountCents',
          'paidAmountCents',
          'paymentIds',
          'settled',
          'settledAt',
          'settledByPaymentId',
          'settlementKind',
          'createdAt',
          'createdById',
          'createdBy',
          'updatedAt',
          'updatedById',
          'updatedBy',
          'deleted',
          'deletedAt',
          'deletedById',
          'deletedBy'
        ]) &&
        validId(data.agreementId) &&
        validId(data.clientId) &&
        data.sequence is int &&
        data.sequence >= 1 &&
        data.sequence <= 60 &&
        data.installmentCount is int &&
        data.installmentCount >= 1 &&
        data.installmentCount <= 60 &&
        data.sequence <= data.installmentCount &&
        validNullableTimestamp(data.dueDate) &&
        validCents(data.baseAmountCents, true) &&
        validCents(data.paidAmountCents, true) &&
        data.paymentIds is list &&
        data.paymentIds.size() <= 200 &&
        data.paymentIds.toSet().size() == data.paymentIds.size() &&
        validInstallmentSettlement(data) &&
        data.createdAt is timestamp &&
        validId(data.createdById) &&
        validString(data.createdBy, 1, 200) &&
        data.updatedAt is timestamp &&
        validId(data.updatedById) &&
        validString(data.updatedBy, 1, 200) &&
        validDeletionState(data);
    }

    function validInstallmentDueDateAtCreate(data, agreement) {
      return (
          agreement.paymentPlan in ['upfront', 'installments'] &&
          data.dueDate is timestamp
        ) || (
          agreement.paymentPlan == 'at_end' &&
          data.dueDate == null
        ) || agreement.paymentPlan == 'custom';
    }

    function validInstallmentCreate(installmentId) {
      let agreementPath =
        /databases/$(database)/documents/financialAgreements/$(request.resource.data.agreementId);
      let agreement = getAfter(agreementPath).data;
      return validFinancialInstallment(request.resource.data) &&
        validCreateAudit(request.resource.data) &&
        request.resource.data.deleted == false &&
        request.resource.data.paidAmountCents == 0 &&
        request.resource.data.paymentIds.size() == 0 &&
        request.resource.data.settled == false &&
        agreement.createdAt == request.time &&
        agreement.deleted == false &&
        agreement.clientId == request.resource.data.clientId &&
        agreement.installmentCount == request.resource.data.installmentCount &&
        agreement.installmentIds[request.resource.data.sequence - 1] ==
          installmentId &&
        validInstallmentDueDateAtCreate(request.resource.data, agreement);
    }

    function validInstallmentPaymentAppend(installmentId) {
      let paymentId =
        request.resource.data.paymentIds[request.resource.data.paymentIds.size() - 1];
      let paymentPath = /databases/$(database)/documents/updates/$(paymentId);
      let payment = getAfter(paymentPath).data;
      return resource.data.deleted == false &&
        request.resource.data.deleted == false &&
        resource.data.settled == false &&
        payment.type == 'Financeiro' &&
        payment.deleted == false &&
        payment.financialAgreementId == request.resource.data.agreementId &&
        payment.financialInstallmentId == installmentId &&
        payment.clientId == request.resource.data.clientId &&
        request.resource.data.paidAmountCents ==
          resource.data.paidAmountCents + payment.amountCents &&
        oneIdAppended(
          resource.data.paymentIds,
          request.resource.data.paymentIds,
          paymentId
        ) &&
        request.resource.data.settled == payment.settlesInstallment &&
        (
          (payment.settlesInstallment == false &&
            request.resource.data.settledAt == null &&
            request.resource.data.settledByPaymentId == null &&
            request.resource.data.settlementKind == null) ||
          (payment.settlesInstallment == true &&
            request.resource.data.settledAt == payment.paidAt &&
            request.resource.data.settledByPaymentId == paymentId &&
            (
              (payment.paymentKind == 'full' &&
                request.resource.data.settlementKind == 'full') ||
              (payment.paymentKind == 'partial' &&
                request.resource.data.settlementKind == 'partial_rolled')
            ))
        ) &&
        validUpdateAudit(request.resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'paidAmountCents',
          'paymentIds',
          'settled',
          'settledAt',
          'settledByPaymentId',
          'settlementKind',
          'updatedAt',
          'updatedById',
          'updatedBy'
        ]);
    }

    function validInstallmentPaymentRemoval(installmentId) {
      let paymentId =
        resource.data.paymentIds[resource.data.paymentIds.size() - 1];
      let paymentPath = /databases/$(database)/documents/updates/$(paymentId);
      let payment = getAfter(paymentPath).data;
      return resource.data.deleted == false &&
        request.resource.data.deleted == false &&
        validId(paymentId) &&
        payment.type == 'Financeiro' &&
        payment.deleted == true &&
        payment.financialAgreementId == resource.data.agreementId &&
        payment.financialInstallmentId == installmentId &&
        payment.amountCents ==
          resource.data.paidAmountCents - request.resource.data.paidAmountCents &&
        request.resource.data.paidAmountCents >= 0 &&
        request.resource.data.paidAmountCents < resource.data.paidAmountCents &&
        oneIdRemoved(resource.data.paymentIds, request.resource.data.paymentIds) &&
        !(paymentId in request.resource.data.paymentIds) &&
        (resource.data.settled == false ||
          resource.data.settledByPaymentId == paymentId) &&
        request.resource.data.settled == false &&
        request.resource.data.settledAt == null &&
        request.resource.data.settledByPaymentId == null &&
        request.resource.data.settlementKind == null &&
        validUpdateAudit(request.resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'paidAmountCents',
          'paymentIds',
          'settled',
          'settledAt',
          'settledByPaymentId',
          'settlementKind',
          'updatedAt',
          'updatedById',
          'updatedBy'
        ]);
    }

    function validInstallmentDelete() {
      let agreementPath =
        /databases/$(database)/documents/financialAgreements/$(resource.data.agreementId);
      return resource.data.deleted == false &&
        resource.data.settled == false &&
        resource.data.paidAmountCents == 0 &&
        resource.data.paymentIds.size() == 0 &&
        request.resource.data.deleted == true &&
        getAfter(agreementPath).data.deleted == true &&
        onlyDeletionAndAuditChanged() &&
        validUpdateAudit(request.resource.data);
    }

    function validInstallmentRestore() {
      let agreementPath =
        /databases/$(database)/documents/financialAgreements/$(resource.data.agreementId);
      return isAdmin() &&
        resource.data.deleted == true &&
        request.resource.data.deleted == false &&
        getAfter(agreementPath).data.deleted == false &&
        onlyDeletionAndAuditChanged() &&
        validUpdateAudit(request.resource.data);
    }

    function validInstallmentClientSync() {
      return isAdmin() &&
        activeClientExists(request.resource.data.clientId) &&
        validUpdateAudit(request.resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'clientId',
          'updatedAt',
          'updatedById',
          'updatedBy'
        ]);
    }

    match /financialInstallments/{id} {
      allow read: if isActive();
      allow create: if isActive() && validInstallmentCreate(id);
      allow update: if isActive() &&
        validFinancialInstallment(request.resource.data) &&
        (
          validInstallmentPaymentAppend(id) ||
          validInstallmentPaymentRemoval(id) ||
          validInstallmentDelete() ||
          validInstallmentRestore() ||
          validInstallmentClientSync()
        );
      allow delete: if false;
    }

    // ------------------------------------------------------------------
    // Recebimentos canônicos em updates
    // ------------------------------------------------------------------

    function validPaymentDeletionState(data) {
      return data.deleted is bool &&
        (
          (data.deleted == false &&
            data.deletedAt == null &&
            data.deletedBy == null &&
            (!data.keys().hasAny(['deletedById']) || data.deletedById == null)) ||
          (data.deleted == true &&
            data.deletedAt is timestamp &&
            data.keys().hasAny(['deletedById']) &&
            validId(data.deletedById) &&
            validString(data.deletedBy, 1, 200))
        );
    }

    function validPaymentReceiptShape(data) {
      return data.receiptMethod in [
          'cash',
          'pix',
          'bank_deposit',
          'card_machine',
          'other'
        ] &&
        (
          (data.receiptMethod == 'other' &&
            validString(data.receiptMethodOther, 1, 200)) ||
          (data.receiptMethod != 'other' &&
            data.receiptMethodOther == '')
        ) &&
        (
          (data.receiptMethod == 'cash' &&
            data.receiptAccountId == '' &&
            data.receiptAccountName == '') ||
          (data.receiptMethod != 'cash' &&
            validString(data.receiptAccountName, 1, 200) &&
            (data.receiptAccountId == '' || validId(data.receiptAccountId)))
        );
    }

    function validFinancialPayment(data) {
      return data.keys().hasAll([
          'type',
          'financialAgreementId',
          'financialInstallmentId',
          'clientId',
          'clientName',
          'clientCode',
          'description',
          'amountCents',
          'paidAt',
          'updateDate',
          'receiptMethod',
          'receiptMethodOther',
          'receiptAccountId',
          'receiptAccountName',
          'financialNote',
          'paymentKind',
          'settlesInstallment',
          'closesAgreement',
          'minimumWageRateIdAtPayment',
          'minimumWageCentsAtPayment',
          'requiredInstallmentAmountCents',
          'agreementTargetCentsAtPayment',
          'author',
          'authorId',
          'createdAt',
          'updatedAt',
          'updatedBy',
          'deleted',
          'deletedAt',
          'deletedBy'
        ]) &&
        data.keys().hasOnly([
          'type',
          'financialAgreementId',
          'financialInstallmentId',
          'clientId',
          'clientName',
          'clientCode',
          'description',
          'amountCents',
          'paidAt',
          'updateDate',
          'receiptMethod',
          'receiptMethodOther',
          'receiptAccountId',
          'receiptAccountName',
          'financialNote',
          'paymentKind',
          'settlesInstallment',
          'closesAgreement',
          'minimumWageRateIdAtPayment',
          'minimumWageCentsAtPayment',
          'requiredInstallmentAmountCents',
          'agreementTargetCentsAtPayment',
          'author',
          'authorId',
          'createdAt',
          'updatedAt',
          'updatedBy',
          'deleted',
          'deletedAt',
          'deletedBy',
          'deletedById'
        ]) &&
        data.type == 'Financeiro' &&
        validId(data.financialAgreementId) &&
        validId(data.financialInstallmentId) &&
        validId(data.clientId) &&
        validString(data.clientName, 1, 300) &&
        validString(data.clientCode, 0, 32) &&
        validString(data.description, 1, 8000) &&
        validCents(data.amountCents, false) &&
        data.paidAt is timestamp &&
        data.updateDate == data.paidAt &&
        validPaymentReceiptShape(data) &&
        validString(data.financialNote, 0, 2000) &&
        data.paymentKind in ['full', 'partial'] &&
        data.settlesInstallment is bool &&
        data.closesAgreement is bool &&
        (data.closesAgreement == false || data.settlesInstallment == true) &&
        validString(data.minimumWageRateIdAtPayment, 0, 128) &&
        (data.minimumWageCentsAtPayment == null ||
          validCents(data.minimumWageCentsAtPayment, false)) &&
        validCents(data.requiredInstallmentAmountCents, false) &&
        validCents(data.agreementTargetCentsAtPayment, false) &&
        data.amountCents <= data.requiredInstallmentAmountCents &&
        (
          (data.paymentKind == 'full' &&
            data.amountCents == data.requiredInstallmentAmountCents) ||
          (data.paymentKind == 'partial' &&
            data.amountCents < data.requiredInstallmentAmountCents)
        ) &&
        validString(data.author, 1, 200) &&
        validId(data.authorId) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        validString(data.updatedBy, 1, 200) &&
        validPaymentDeletionState(data);
    }

    function validReceiptAccountAtPayment(data) {
      return data.receiptMethod == 'cash' ||
        data.receiptAccountId == '' || (
          get(/databases/$(database)/documents/receivingAccounts/$(data.receiptAccountId))
            .data.deleted == false &&
          get(/databases/$(database)/documents/receivingAccounts/$(data.receiptAccountId))
            .data.name == data.receiptAccountName
        );
    }

    function validWageAtPayment(data, agreement) {
      return (
          agreement.valueBasis == 'custom' &&
          data.minimumWageRateIdAtPayment == '' &&
          data.minimumWageCentsAtPayment == null &&
          data.agreementTargetCentsAtPayment == agreement.originalAmountCents
        ) || (
          agreement.valueBasis != 'custom' &&
          validId(data.minimumWageRateIdAtPayment) &&
          get(/databases/$(database)/documents/minimumWages/$(data.minimumWageRateIdAtPayment))
            .data.deleted == false &&
          get(/databases/$(database)/documents/minimumWages/$(data.minimumWageRateIdAtPayment))
            .data.amountCents == data.minimumWageCentsAtPayment &&
          get(/databases/$(database)/documents/minimumWages/$(data.minimumWageRateIdAtPayment))
            .data.effectiveFrom <= data.paidAt &&
          (
            (agreement.originalAmountCents >=
                data.minimumWageCentsAtPayment * agreement.minimumWageMultiplier &&
              data.agreementTargetCentsAtPayment == agreement.originalAmountCents) ||
            (agreement.originalAmountCents <
                data.minimumWageCentsAtPayment * agreement.minimumWageMultiplier &&
              data.agreementTargetCentsAtPayment >=
                data.minimumWageCentsAtPayment * agreement.minimumWageMultiplier &&
              data.agreementTargetCentsAtPayment <=
                data.minimumWageCentsAtPayment * agreement.minimumWageMultiplier + 1)
          )
        );
    }

    function validPaymentInstallmentAfter(paymentId, data, installment) {
      let installmentPath =
        /databases/$(database)/documents/financialInstallments/$(data.financialInstallmentId);
      let afterInstallment = getAfter(installmentPath).data;
      return afterInstallment.paidAmountCents ==
          installment.paidAmountCents + data.amountCents &&
        oneIdAppended(installment.paymentIds, afterInstallment.paymentIds, paymentId) &&
        afterInstallment.settled == data.settlesInstallment &&
        (
          (data.settlesInstallment == false &&
            afterInstallment.settledAt == null &&
            afterInstallment.settledByPaymentId == null &&
            afterInstallment.settlementKind == null) ||
          (data.settlesInstallment == true &&
            afterInstallment.settledAt == data.paidAt &&
            afterInstallment.settledByPaymentId == paymentId &&
            (
              (data.paymentKind == 'full' &&
                afterInstallment.settlementKind == 'full') ||
              (data.paymentKind == 'partial' &&
                afterInstallment.settlementKind == 'partial_rolled')
            ))
        );
    }

    function validPaymentAgreementAfter(paymentId, data, agreement) {
      let agreementPath =
        /databases/$(database)/documents/financialAgreements/$(data.financialAgreementId);
      let afterAgreement = getAfter(agreementPath).data;
      return (
          (data.closesAgreement == false &&
            afterAgreement.settled == false &&
            afterAgreement.settledByPaymentId == null) ||
          (data.closesAgreement == true &&
            afterAgreement.settled == true &&
            afterAgreement.settledByPaymentId == paymentId &&
            afterAgreement.settledAt == data.paidAt &&
            afterAgreement.settledTargetCents ==
              data.agreementTargetCentsAtPayment &&
            (
              (agreement.valueBasis == 'custom' &&
                afterAgreement.settledMinimumWageRateId == null &&
                afterAgreement.settledMinimumWageCents == null) ||
              (agreement.valueBasis != 'custom' &&
                afterAgreement.settledMinimumWageRateId ==
                  data.minimumWageRateIdAtPayment &&
                afterAgreement.settledMinimumWageCents ==
                  data.minimumWageCentsAtPayment)
            ))
        );
    }

    function validFinancialPaymentCreate(paymentId) {
      let agreement = get(
        /databases/$(database)/documents/financialAgreements/$(request.resource.data.financialAgreementId)
      ).data;
      let installment = get(
        /databases/$(database)/documents/financialInstallments/$(request.resource.data.financialInstallmentId)
      ).data;
      let client = get(
        /databases/$(database)/documents/clients/$(request.resource.data.clientId)
      ).data;
      return validFinancialPayment(request.resource.data) &&
        request.resource.data.authorId == request.auth.uid &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.deleted == false &&
        request.resource.data.paidAt <= request.time + duration.value(2, 'm') &&
        (!client.keys().hasAny(['deleted']) || client.deleted != true) &&
        request.resource.data.clientName == client.name &&
        request.resource.data.clientCode ==
          (client.keys().hasAny(['code']) ? client.code : '') &&
        agreement.deleted == false &&
        agreement.settled == false &&
        agreement.clientId == request.resource.data.clientId &&
        installment.deleted == false &&
        installment.settled == false &&
        installment.agreementId == request.resource.data.financialAgreementId &&
        installment.clientId == request.resource.data.clientId &&
        agreement.installmentIds[installment.sequence - 1] ==
          request.resource.data.financialInstallmentId &&
        request.resource.data.requiredInstallmentAmountCents <=
          request.resource.data.agreementTargetCentsAtPayment &&
        (
          (installment.sequence < installment.installmentCount &&
            request.resource.data.requiredInstallmentAmountCents ==
              installment.baseAmountCents &&
            request.resource.data.settlesInstallment == true &&
            request.resource.data.closesAgreement == false) ||
          (installment.sequence == installment.installmentCount &&
            request.resource.data.requiredInstallmentAmountCents >=
              installment.baseAmountCents -
                installment.paidAmountCents +
                request.resource.data.agreementTargetCentsAtPayment -
                agreement.originalAmountCents)
        ) &&
        (request.resource.data.closesAgreement == false ||
          installment.sequence == installment.installmentCount) &&
        validReceiptAccountAtPayment(request.resource.data) &&
        validWageAtPayment(request.resource.data, agreement) &&
        validPaymentInstallmentAfter(
          paymentId,
          request.resource.data,
          installment
        ) &&
        validPaymentAgreementAfter(paymentId, request.resource.data, agreement);
    }

    function validFinancialPaymentDelete(paymentId) {
      let installmentPath =
        /databases/$(database)/documents/financialInstallments/$(resource.data.financialInstallmentId);
      let agreementPath =
        /databases/$(database)/documents/financialAgreements/$(resource.data.financialAgreementId);
      let installment = get(installmentPath).data;
      let afterInstallment = getAfter(installmentPath).data;
      return (isAdmin() || resource.data.authorId == request.auth.uid) &&
        resource.data.deleted == false &&
        request.resource.data.deleted == true &&
        request.resource.data.deletedAt == request.time &&
        request.resource.data.deletedById == request.auth.uid &&
        request.resource.data.updatedAt == request.time &&
        onlyDeletionAndAuditChanged() &&
        installment.deleted == false &&
        paymentId in installment.paymentIds &&
        (installment.settled == false ||
          installment.settledByPaymentId == paymentId) &&
        afterInstallment.deleted == false &&
        afterInstallment.paidAmountCents ==
          installment.paidAmountCents - resource.data.amountCents &&
        afterInstallment.paidAmountCents >= 0 &&
        !(paymentId in afterInstallment.paymentIds) &&
        oneIdRemoved(installment.paymentIds, afterInstallment.paymentIds) &&
        afterInstallment.settled == false &&
        afterInstallment.settledAt == null &&
        afterInstallment.settledByPaymentId == null &&
        afterInstallment.settlementKind == null &&
        getAfter(agreementPath).data.deleted == false &&
        getAfter(agreementPath).data.settled == false;
    }

    function validFinancialPaymentRestore(paymentId) {
      let installmentPath =
        /databases/$(database)/documents/financialInstallments/$(resource.data.financialInstallmentId);
      let agreementPath =
        /databases/$(database)/documents/financialAgreements/$(resource.data.financialAgreementId);
      let installment = get(installmentPath).data;
      let afterInstallment = getAfter(installmentPath).data;
      return isAdmin() &&
        resource.data.deleted == true &&
        request.resource.data.deleted == false &&
        request.resource.data.deletedAt == null &&
        request.resource.data.deletedById == null &&
        request.resource.data.deletedBy == null &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'deleted',
          'deletedAt',
          'deletedById',
          'deletedBy',
          'updatedAt',
          'updatedBy'
        ]) &&
        installment.deleted == false &&
        installment.settled == false &&
        !(paymentId in installment.paymentIds) &&
        afterInstallment.paidAmountCents ==
          installment.paidAmountCents + resource.data.amountCents &&
        oneIdAppended(installment.paymentIds, afterInstallment.paymentIds, paymentId) &&
        afterInstallment.settled == resource.data.settlesInstallment &&
        (
          (resource.data.settlesInstallment == false &&
            afterInstallment.settledAt == null &&
            afterInstallment.settledByPaymentId == null &&
            afterInstallment.settlementKind == null) ||
          (resource.data.settlesInstallment == true &&
            afterInstallment.settledAt == resource.data.paidAt &&
            afterInstallment.settledByPaymentId == paymentId &&
            (
              (resource.data.paymentKind == 'full' &&
                afterInstallment.settlementKind == 'full') ||
              (resource.data.paymentKind == 'partial' &&
                afterInstallment.settlementKind == 'partial_rolled')
            ))
        ) &&
        getAfter(agreementPath).data.deleted == false &&
        validPaymentAgreementAfter(
          paymentId,
          request.resource.data,
          get(agreementPath).data
        );
    }

    function validFinancialPaymentClientSync() {
      let client = get(
        /databases/$(database)/documents/clients/$(request.resource.data.clientId)
      ).data;
      return isAdmin() &&
        activeClientExists(request.resource.data.clientId) &&
        request.resource.data.clientName == client.name &&
        request.resource.data.clientCode ==
          (client.keys().hasAny(['code']) ? client.code : '') &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'clientId',
          'clientName',
          'clientCode',
          'updatedAt',
          'updatedBy'
        ]);
    }

    function validFinancialPaymentUpdate(paymentId) {
      return resource.data.type == 'Financeiro' &&
        request.resource.data.type == 'Financeiro' &&
        validFinancialPayment(request.resource.data) &&
        (
          validFinancialPaymentDelete(paymentId) ||
          validFinancialPaymentRestore(paymentId) ||
          validFinancialPaymentClientSync()
        );
    }

    // Perfis de usuário: leitura por usuários ativos (dropdown de responsáveis).
    // O próprio usuário altera somente suas preferências de exibição.
    match /users/{uid} {
      allow read: if isActive();
      allow create: if isAdmin() || (isBootstrapAdmin() && request.auth.uid == uid);
      allow update: if isAdmin() || (
        isActive() &&
        request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'operationPendingItemIds',
          'attendanceQuickTexts'
        ]) &&
        (!request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['operationPendingItemIds']) ||
          (request.resource.data.operationPendingItemIds is map &&
            request.resource.data.operationPendingItemIds.size() <= 50)) &&
        (!request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['attendanceQuickTexts']) ||
          (request.resource.data.attendanceQuickTexts is list &&
            request.resource.data.attendanceQuickTexts.size() <= 20))
      );
      allow delete: if false;
    }

    // Configurações: leitura para ativos, escrita só admin.
    match /clientTypes/{id} {
      allow read: if isActive();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /messageTemplates/{id} {
      allow read: if isActive();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // Dados operacionais: usuários ativos leem, criam e atualizam.
    // Delete físico é bloqueado para todos; remoções usam soft delete auditável.
    match /clients/{id} {
      allow read, create, update: if isActive();
      allow delete: if false;
    }

    match /caseFiles/{id} {
      allow read, create, update: if isActive();
      allow delete: if false;
    }

    match /updates/{id} {
      allow read: if isActive();
      allow create: if isActive() &&
        (
          request.resource.data.type != 'Financeiro' ||
          validFinancialPaymentCreate(id)
        );
      allow update: if isActive() &&
        (
          (resource.data.type != 'Financeiro' &&
            request.resource.data.type != 'Financeiro') ||
          validFinancialPaymentUpdate(id)
        );
      allow delete: if false;
    }

    match /processes/{id} {
      allow read, create, update: if isActive();
      allow delete: if false;
    }

    match /clientGroups/{id} {
      allow read, create, update: if isActive();
      allow delete: if false;
    }

    // Decisões e auditoria de possíveis duplicatas são exclusivas do administrador bootstrap.
    match /duplicateResolutions/{id} {
      allow read, create, update: if isBootstrapAdmin();
      allow delete: if false;
    }

    // Qualquer outra coleção: bloqueada.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
