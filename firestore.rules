rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------
    // Segurança real: só usuários autenticados e ativos acessam os dados.
    // Papéis: admin (gerencia tudo) e operator (trabalho do dia a dia).
    // O e-mail abaixo é o administrador "de fábrica" (bootstrap) — também
    // definido em src/lib/constants.ts. Se mudar lá, mude aqui.
    // ------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isBootstrapAdmin() {
      return isSignedIn() && request.auth.token.email == 'okjuridico@gmail.com';
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasProfile() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isActive() {
      return isSignedIn() && (isBootstrapAdmin() || (hasProfile() && profile().active == true));
    }

    function isAdmin() {
      return isSignedIn() && (isBootstrapAdmin() || (hasProfile() && profile().active == true && profile().role == 'admin'));
    }

    // Perfis de usuário: leitura por usuários ativos (dropdown de responsáveis).
    // O próprio usuário altera somente suas preferências de exibição.
    match /users/{uid} {
      allow read: if isActive();
      allow create: if isAdmin() || (isBootstrapAdmin() && request.auth.uid == uid);
      allow update: if isAdmin() || (
        isActive() &&
        request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['operationPendingItemIds', 'attendanceQuickTexts']) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['operationPendingItemIds']) ||
          (request.resource.data.operationPendingItemIds is map && request.resource.data.operationPendingItemIds.size() <= 50)) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['attendanceQuickTexts']) ||
          (request.resource.data.attendanceQuickTexts is list && request.resource.data.attendanceQuickTexts.size() <= 20))
      );
      allow delete: if false;
    }

    // Configurações: leitura para ativos, escrita só admin.
    match /clientTypes/{id} {
      allow read: if isActive();
      allow create, update: if isAdmin();
      allow delete: if false;
    }
    match /messageTemplates/{id} {
      allow read: if isActive();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // Dados operacionais: usuários ativos leem, criam e atualizam.
    // Delete físico é bloqueado para todos; remoções usam soft delete auditável.
    match /clients/{id} {
      allow read, create, update: if isActive();
      allow delete: if false;
    }
    match /caseFiles/{id} {
      allow read, create, update: if isActive();
      allow delete: if false;
    }
    match /updates/{id} {
      allow read, create, update: if isActive();
      allow delete: if false;
    }
    match /processes/{id} {
      allow read, create, update: if isActive();
      allow delete: if false;
    }
    match /clientGroups/{id} {
      allow read, create, update: if isActive();
      allow delete: if false;
    }

    // Decisões e auditoria de possíveis duplicatas são exclusivas da administração.
    match /duplicateResolutions/{id} {
      allow read, create, update: if isAdmin();
      allow delete: if false;
    }

    // Qualquer outra coleção: bloqueada.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
