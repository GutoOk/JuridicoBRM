rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------
    // Modelos financeiros protegidos por estas regras
    //
    // minimumWages:
    //   valor e vigência do salário mínimo, autoria e soft delete.
    // receivingAccounts:
    //   nome/observação da conta, autoria e soft delete.
    // legalTemplateFolders:
    //   pastas compartilhadas para organizar modelos, com autoria e soft delete.
    // legalTemplates / legalQuickParts:
    //   conteúdo JSON estruturado serializado, estilos, página, versão, proprietário
    //   imutável e auditoria. Todos os ativos leem; criador ou admin alteram.
    // legalDocuments:
    //   cópia independente vinculada ao cliente e à versão de origem; usuários
    //   ativos colaboram, sem poder trocar cliente, origem ou autoria inicial.
    // legalTemplateVersions / legalDocumentVersions / legalQuickPartVersions:
    //   snapshots imutáveis criados em salvamentos explícitos e restaurações.
    // financialAgreements:
    //   cliente, base/valor original, valores regular/final, plano, agregados
    //   O(1), ponteiro do último recebimento, quitação e soft delete.
    // financialInstallments:
    //   ID {agreementId}_{sequence}, acordo/cliente, sequência, vencimento,
    //   valor, pagamentos e soft delete.
    // updates com type == "Financeiro":
    //   recebimento canônico, vínculo acordo/parcela, valor, data, meio,
    //   conta, instantâneo da correção, ponteiro do recebimento anterior,
    //   autoria e soft delete.
    //
    // Os modelos operacionais legados abaixo mantêm as permissões anteriores
    // para não quebrar documentos históricos com esquemas heterogêneos.
    // ------------------------------------------------------------------

    // Segurança real: só usuários autenticados e ativos acessam os dados.
    // Papéis: admin (gerencia tudo) e operator (trabalho do dia a dia).
    // O e-mail abaixo é o administrador "de fábrica" (bootstrap) — também
    // definido em src/lib/constants.ts. Se mudar lá, mude aqui.
    function isSignedIn() {
      return request.auth != null;
    }

    function isBootstrapAdmin() {
      return isSignedIn() && request.auth.token.email == 'okjuridico@gmail.com';
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasProfile() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isActive() {
      return isSignedIn() &&
        (isBootstrapAdmin() || (hasProfile() && profile().active == true));
    }

    function isAdmin() {
      return isSignedIn() &&
        (isBootstrapAdmin() ||
          (hasProfile() && profile().active == true && profile().role == 'admin'));
    }

    // ------------------------------------------------------------------
    // Validadores compartilhados do domínio financeiro
    // ------------------------------------------------------------------

    function validId(value) {
      return value is string &&
        value.size() >= 1 &&
        value.size() <= 128 &&
        value.matches('^[^/]+$');
    }

    function validString(value, minSize, maxSize) {
      return value is string &&
        value.size() >= minSize &&
        value.size() <= maxSize;
    }

    function validNullableTimestamp(value) {
      return value == null || value is timestamp;
    }

    function validNullableId(value) {
      return value == null || validId(value);
    }

    function validCents(value, allowZero) {
      return value is int &&
        value <= 100000000000000 &&
        (allowZero ? value >= 0 : value > 0);
    }

    function deterministicInstallmentId(agreementId, sequence) {
      return agreementId + '_' + string(sequence);
    }

    function canReadFinancialResource() {
      return isAdmin() || (isActive() && resource.data.deleted == false);
    }

    function activeClientExists(clientId) {
      return validId(clientId) &&
        exists(/databases/$(database)/documents/clients/$(clientId)) &&
        (!get(/databases/$(database)/documents/clients/$(clientId)).data.keys()
            .hasAny(['deleted']) ||
          get(/databases/$(database)/documents/clients/$(clientId)).data.deleted != true);
    }

    function validDeletionState(data) {
      return data.deleted is bool &&
        (
          (data.deleted == false &&
            data.deletedAt == null &&
            data.deletedById == null &&
            data.deletedBy == null) ||
          (data.deleted == true &&
            data.deletedAt is timestamp &&
            validId(data.deletedById) &&
            validString(data.deletedBy, 1, 200))
        );
    }

    function validCreateAudit(data) {
      return data.createdAt == request.time &&
        data.createdById == request.auth.uid &&
        validString(data.createdBy, 1, 200) &&
        data.updatedAt == request.time &&
        data.updatedById == request.auth.uid &&
        validString(data.updatedBy, 1, 200);
    }

    function validUpdateAudit(data) {
      return data.updatedAt == request.time &&
        data.updatedById == request.auth.uid &&
        validString(data.updatedBy, 1, 200);
    }

    function onlyDeletionAndAuditChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'deleted',
        'deletedAt',
        'deletedById',
        'deletedBy',
        'updatedAt',
        'updatedById',
        'updatedBy'
      ]);
    }

    function oneIdAppended(beforeIds, afterIds, paymentId) {
      return validId(paymentId) &&
        afterIds.size() == beforeIds.size() + 1 &&
        afterIds[afterIds.size() - 1] == paymentId &&
        afterIds.toSet().size() == afterIds.size() &&
        !(paymentId in beforeIds) &&
        beforeIds.toSet().difference(afterIds.toSet()).size() == 0;
    }

    function oneIdRemoved(beforeIds, afterIds) {
      return beforeIds.size() == afterIds.size() + 1 &&
        afterIds.toSet().size() == afterIds.size() &&
        afterIds.toSet().difference(beforeIds.toSet()).size() == 0;
    }

    function validInstallmentIds(ids, installmentCount, agreementId) {
      return ids is list &&
        installmentCount is int &&
        ids.size() == installmentCount &&
        ids.size() >= 1 &&
        ids.size() <= 60 &&
        ids[0] == deterministicInstallmentId(agreementId, 1) &&
        ids[ids.size() - 1] ==
          deterministicInstallmentId(agreementId, installmentCount) &&
        ids.toSet().size() == ids.size();
    }

    // ------------------------------------------------------------------
    // Salários mínimos
    // ------------------------------------------------------------------

    function validMinimumWage(data) {
      return data.keys().hasAll([
          'amountCents',
          'effectiveFrom',
          'note',
          'createdAt',
          'createdById',
          'createdBy',
          'updatedAt',
          'updatedById',
          'updatedBy',
          'deleted',
          'deletedAt',
          'deletedById',
          'deletedBy'
        ]) &&
        data.keys().hasOnly([
          'amountCents',
          'effectiveFrom',
          'note',
          'createdAt',
          'createdById',
          'createdBy',
          'updatedAt',
          'updatedById',
          'updatedBy',
          'deleted',
          'deletedAt',
          'deletedById',
          'deletedBy'
        ]) &&
        data.amountCents is int &&
        data.amountCents > 0 &&
        data.amountCents <= 1000000000 &&
        data.effectiveFrom is timestamp &&
        validString(data.note, 0, 2000) &&
        data.createdAt is timestamp &&
        validId(data.createdById) &&
        validString(data.createdBy, 1, 200) &&
        data.updatedAt is timestamp &&
        validId(data.updatedById) &&
        validString(data.updatedBy, 1, 200) &&
        validDeletionState(data);
    }

    function validMinimumWageUpdate() {
      return validMinimumWage(request.resource.data) &&
        validUpdateAudit(request.resource.data) &&
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'note',
            'updatedAt',
            'updatedById',
            'updatedBy'
          ]) ||
          onlyDeletionAndAuditChanged()
        );
    }

    match /minimumWages/{id} {
      allow read: if canReadFinancialResource();
      allow create: if isAdmin() &&
        validMinimumWage(request.resource.data) &&
        validCreateAudit(request.resource.data) &&
        request.resource.data.deleted == false;
      allow update: if isAdmin() && validMinimumWageUpdate();
      allow delete: if false;
    }

    // ------------------------------------------------------------------
    // Contas de recebimento
    // ------------------------------------------------------------------

    function validReceivingAccount(data) {
      return data.keys().hasAll([
          'name',
          'note',
          'createdAt',
          'createdById',
          'createdBy',
          'updatedAt',
          'updatedById',
          'updatedBy',
          'deleted',
          'deletedAt',
          'deletedById',
          'deletedBy'
        ]) &&
        data.keys().hasOnly([
          'name',
          'note',
          'createdAt',
          'createdById',
          'createdBy',
          'updatedAt',
          'updatedById',
          'updatedBy',
          'deleted',
          'deletedAt',
          'deletedById',
          'deletedBy'
        ]) &&
        validString(data.name, 1, 200) &&
        validString(data.note, 0, 2000) &&
        data.createdAt is timestamp &&
        validId(data.createdById) &&
        validString(data.createdBy, 1, 200) &&
        data.updatedAt is timestamp &&
        validId(data.updatedById) &&
        validString(data.updatedBy, 1, 200) &&
        validDeletionState(data);
    }

    function validReceivingAccountUpdate() {
      return validReceivingAccount(request.resource.data) &&
        validUpdateAudit(request.resource.data) &&
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name',
            'note',
            'updatedAt',
            'updatedById',
            'updatedBy'
          ]) ||
          onlyDeletionAndAuditChanged()
        );
    }

    match /receivingAccounts/{id} {
      allow read: if canReadFinancialResource();
      allow create: if isAdmin() &&
        validReceivingAccount(request.resource.data) &&
        validCreateAudit(request.resource.data) &&
        request.resource.data.deleted == false;
      allow update: if isAdmin() && validReceivingAccountUpdate();
      allow delete: if false;
    }

    // ------------------------------------------------------------------
    // Valores devidos
    // ------------------------------------------------------------------

    function validAgreementValueShape(data) {
      return (
          data.valueBasis == 'custom' &&
          data.minimumWageMultiplier == null &&
          data.baseMinimumWageRateId == null &&
          data.baseMinimumWageCents == null &&
          data.correctionPolicy == 'none'
        ) || (
          data.valueBasis in [
            'half_minimum_wage',
            'minimum_wage',
            'one_and_half_minimum_wage'
          ] &&
          data.minimumWageMultiplier is number &&
          (
            (data.valueBasis == 'half_minimum_wage' &&
              data.minimumWageMultiplier == 0.5) ||
            (data.valueBasis == 'minimum_wage' &&
              data.minimumWageMultiplier == 1) ||
            (data.valueBasis == 'one_and_half_minimum_wage' &&
              data.minimumWageMultiplier == 1.5)
          ) &&
          validId(data.baseMinimumWageRateId) &&
          validCents(data.baseMinimumWageCents, false) &&
          data.originalAmountCents >=
            data.baseMinimumWageCents * data.minimumWageMultiplier &&
          data.originalAmountCents <=
            data.baseMinimumWageCents * data.minimumWageMultiplier + 1 &&
          data.correctionPolicy == 'minimum_wage_at_closing_payment'
        );
    }

    function validAgreementPlan(data) {
      return data.paymentPlan in ['upfront', 'installments', 'at_end', 'custom'] &&
        data.installmentCount is int &&
        data.installmentCount >= 1 &&
        data.installmentCount <= 60 &&
        (
          (data.paymentPlan in ['upfront', 'at_end'] &&
            data.installmentCount == 1 &&
            data.customPaymentTerms == '') ||
          (data.paymentPlan == 'installments' &&
            data.installmentCount >= 2 &&
            data.customPaymentTerms == '') ||
          (data.paymentPlan == 'custom' &&
            validString(data.customPaymentTerms, 1, 1000))
        );
    }

    function validAgreementWageAtCreate(data) {
      return data.valueBasis == 'custom' || (
        get(/databases/$(database)/documents/minimumWages/$(data.baseMinimumWageRateId))
          .data.deleted == false &&
        get(/databases/$(database)/documents/minimumWages/$(data.baseMinimumWageRateId))
          .data.amountCents == data.baseMinimumWageCents &&
        get(/databases/$(database)/documents/minimumWages/$(data.baseMinimumWageRateId))
          .data.effectiveFrom <= data.agreementDate
      );
    }

    function validAgreementCreate(agreementId) {
      let data = request.resource.data;
      return data.keys().size() == 37 &&
        validId(data.clientId) &&
        activeClientExists(data.clientId) &&
        validString(data.description, 0, 160) &&
        data.agreementDate is timestamp &&
        validCents(data.originalAmountCents, false) &&
        validAgreementValueShape(data) &&
        validAgreementPlan(data) &&
        validInstallmentIds(
          data.installmentIds,
          data.installmentCount,
          agreementId
        ) &&
        validCents(data.regularInstallmentAmountCents, false) &&
        validCents(data.finalInstallmentAmountCents, false) &&
        data.regularInstallmentAmountCents * (data.installmentCount - 1) +
          data.finalInstallmentAmountCents == data.originalAmountCents &&
        data.receivedAmountCents == 0 &&
        data.activePaymentCount == 0 &&
        data.settledInstallmentCount == 0 &&
        data.nextOpenSequence == 1 &&
        data.lastPaymentId == null &&
        validString(data.note, 0, 2000) &&
        data.settled == false &&
        data.settledAt == null &&
        data.settledByPaymentId == null &&
        data.settledTargetCents == null &&
        data.settledMinimumWageRateId == null &&
        data.settledMinimumWageCents == null &&
        validCreateAudit(data) &&
        data.deleted == false &&
        data.deletedAt == null &&
        data.deletedById == null &&
        data.deletedBy == null &&
        validAgreementWageAtCreate(data);
    }

    function validAgreementDelete() {
      return request.resource.data.deleted == true &&
        resource.data.deleted == false &&
        resource.data.settled == false &&
        resource.data.receivedAmountCents == 0 &&
        resource.data.activePaymentCount == 0 &&
        resource.data.settledInstallmentCount == 0 &&
        resource.data.lastPaymentId == null &&
        request.resource.data.deletedAt == request.time &&
        request.resource.data.deletedById == request.auth.uid &&
        validString(request.resource.data.deletedBy, 1, 200) &&
        onlyDeletionAndAuditChanged() &&
        validUpdateAudit(request.resource.data);
    }

    function validAgreementRestore() {
      return resource.data.deleted == true &&
        isAdmin() &&
        resource.data.settled == false &&
        resource.data.receivedAmountCents == 0 &&
        resource.data.activePaymentCount == 0 &&
        resource.data.settledInstallmentCount == 0 &&
        resource.data.lastPaymentId == null &&
        request.resource.data.deleted == false &&
        request.resource.data.deletedAt == null &&
        request.resource.data.deletedById == null &&
        request.resource.data.deletedBy == null &&
        onlyDeletionAndAuditChanged() &&
        validUpdateAudit(request.resource.data);
    }

    function validAgreementPaymentAppend(agreementId) {
      let paymentId = request.resource.data.lastPaymentId;
      let payment = getAfter(
        /databases/$(database)/documents/updates/$(paymentId)
      ).data;
      return resource.data.deleted == false &&
        resource.data.settled == false &&
        payment.type == 'Financeiro' &&
        payment.deleted == false &&
        payment.updatedAt == request.time &&
        payment.financialAgreementId == agreementId &&
        payment.previousAgreementPaymentId == resource.data.lastPaymentId &&
        request.resource.data.receivedAmountCents ==
          resource.data.receivedAmountCents + payment.amountCents &&
        request.resource.data.activePaymentCount ==
          resource.data.activePaymentCount + 1 &&
        request.resource.data.settledInstallmentCount ==
          resource.data.settledInstallmentCount +
            (payment.settlesInstallment ? 1 : 0) &&
        request.resource.data.nextOpenSequence ==
          resource.data.nextOpenSequence &&
        request.resource.data.settled == payment.closesAgreement &&
        request.resource.data.settledAt ==
          (payment.closesAgreement ? payment.paidAt : null) &&
        request.resource.data.settledByPaymentId ==
          (payment.closesAgreement ? paymentId : null) &&
        request.resource.data.settledTargetCents ==
          (
            payment.closesAgreement
              ? payment.agreementTargetCentsAtPayment
              : null
          ) &&
        request.resource.data.settledMinimumWageRateId ==
          (
            payment.closesAgreement &&
              resource.data.valueBasis != 'custom'
              ? payment.minimumWageRateIdAtPayment
              : null
          ) &&
        request.resource.data.settledMinimumWageCents ==
          (
            payment.closesAgreement
              ? payment.minimumWageCentsAtPayment
              : null
          ) &&
        (
          payment.closesAgreement == false ||
          (
            payment.settlesInstallment == true &&
            request.resource.data.receivedAmountCents ==
              payment.agreementTargetCentsAtPayment &&
            request.resource.data.settledInstallmentCount ==
              resource.data.installmentCount
          )
        ) &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.updatedById == request.auth.uid &&
        request.resource.data.updatedBy == payment.updatedBy &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'receivedAmountCents',
          'activePaymentCount',
          'settledInstallmentCount',
          'nextOpenSequence',
          'lastPaymentId',
          'settled',
          'settledAt',
          'settledByPaymentId',
          'settledTargetCents',
          'settledMinimumWageRateId',
          'settledMinimumWageCents',
          'updatedAt',
          'updatedById',
          'updatedBy'
        ]);
    }

    function validAgreementPaymentRemoval(agreementId) {
      let paymentId = resource.data.lastPaymentId;
      let payment = getAfter(
        /databases/$(database)/documents/updates/$(paymentId)
      ).data;
      return resource.data.deleted == false &&
        request.resource.data.deleted == false &&
        validId(paymentId) &&
        payment.type == 'Financeiro' &&
        payment.deleted == true &&
        payment.updatedAt == request.time &&
        payment.financialAgreementId == agreementId &&
        payment.clientId == resource.data.clientId &&
        request.resource.data.lastPaymentId ==
          payment.previousAgreementPaymentId &&
        resource.data.receivedAmountCents >= payment.amountCents &&
        resource.data.activePaymentCount >= 1 &&
        resource.data.settledInstallmentCount >=
          (payment.settlesInstallment ? 1 : 0) &&
        request.resource.data.receivedAmountCents ==
          resource.data.receivedAmountCents - payment.amountCents &&
        request.resource.data.activePaymentCount ==
          resource.data.activePaymentCount - 1 &&
        request.resource.data.settledInstallmentCount ==
          resource.data.settledInstallmentCount -
            (payment.settlesInstallment ? 1 : 0) &&
        request.resource.data.nextOpenSequence ==
          resource.data.nextOpenSequence &&
        request.resource.data.settled == false &&
        request.resource.data.settledAt == null &&
        request.resource.data.settledByPaymentId == null &&
        request.resource.data.settledTargetCents == null &&
        request.resource.data.settledMinimumWageRateId == null &&
        request.resource.data.settledMinimumWageCents == null &&
        (resource.data.settled == false || payment.closesAgreement == true) &&
        validUpdateAudit(request.resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'receivedAmountCents',
          'activePaymentCount',
          'settledInstallmentCount',
          'nextOpenSequence',
          'lastPaymentId',
          'settled',
          'settledAt',
          'settledByPaymentId',
          'settledTargetCents',
          'settledMinimumWageRateId',
          'settledMinimumWageCents',
          'updatedAt',
          'updatedById',
          'updatedBy'
        ]);
    }

    function validAgreementClientSync() {
      return isAdmin() &&
        activeClientExists(request.resource.data.clientId) &&
        validUpdateAudit(request.resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'clientId',
          'updatedAt',
          'updatedById',
          'updatedBy'
        ]);
    }

    function validAgreementMetadataEdit() {
      return resource.data.deleted == false &&
        request.resource.data.deleted == false &&
        validString(request.resource.data.description, 0, 160) &&
        validString(request.resource.data.note, 0, 2000) &&
        validUpdateAudit(request.resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'description',
          'note',
          'updatedAt',
          'updatedById',
          'updatedBy'
        ]);
    }

    match /financialAgreements/{id} {
      allow read: if canReadFinancialResource();
      allow create: if isActive() && validAgreementCreate(id);
      allow update: if isActive() &&
        request.resource.data.installmentIds == resource.data.installmentIds &&
        (
          validAgreementDelete() ||
          validAgreementRestore() ||
           validAgreementPaymentAppend(id) ||
          validAgreementPaymentRemoval(id) ||
          validAgreementMetadataEdit() ||
          validAgreementClientSync()
        );
      allow delete: if false;
    }

    // ------------------------------------------------------------------
    // Parcelas
    // ------------------------------------------------------------------

    function validInstallmentDueDateAtCreate(data, agreement) {
      return (
          agreement.paymentPlan in ['upfront', 'installments'] &&
          data.dueDate is timestamp
        ) || (
          agreement.paymentPlan == 'at_end' &&
          data.dueDate == null
        ) || agreement.paymentPlan == 'custom';
    }

    function validInstallmentCreate(installmentId) {
      let data = request.resource.data;
      let agreementPath =
        /databases/$(database)/documents/financialAgreements/$(data.agreementId);
      let agreement = getAfter(agreementPath).data;
      return data.keys().size() == 22 &&
        validId(data.agreementId) &&
        validId(data.clientId) &&
        data.sequence is int &&
        data.sequence >= 1 &&
        data.sequence <= 60 &&
        data.installmentCount is int &&
        data.installmentCount >= 1 &&
        data.installmentCount <= 60 &&
        data.sequence <= data.installmentCount &&
        installmentId == deterministicInstallmentId(
          data.agreementId,
          data.sequence
        ) &&
        validNullableTimestamp(data.dueDate) &&
        validCents(data.baseAmountCents, false) &&
        data.paidAmountCents == 0 &&
        data.paymentIds is list &&
        data.paymentIds.size() == 0 &&
        data.settled == false &&
        data.settledAt == null &&
        data.settledByPaymentId == null &&
        data.settlementKind == null &&
        data.createdAt == agreement.createdAt &&
        data.createdById == agreement.createdById &&
        data.createdBy == agreement.createdBy &&
        data.updatedAt == agreement.updatedAt &&
        data.updatedById == agreement.updatedById &&
        data.updatedBy == agreement.updatedBy &&
        data.deleted == false &&
        data.deletedAt == null &&
        data.deletedById == null &&
        data.deletedBy == null &&
        agreement.createdAt == request.time &&
        agreement.deleted == false &&
        agreement.clientId == data.clientId &&
        agreement.installmentCount == data.installmentCount &&
        agreement.installmentIds[data.sequence - 1] ==
          installmentId &&
        data.baseAmountCents ==
          (
            data.sequence == agreement.installmentCount
              ? agreement.finalInstallmentAmountCents
              : agreement.regularInstallmentAmountCents
          ) &&
        validInstallmentDueDateAtCreate(data, agreement);
    }

    function validInstallmentPaymentAppend(installmentId) {
      let paymentId =
        request.resource.data.paymentIds[request.resource.data.paymentIds.size() - 1];
      let paymentPath = /databases/$(database)/documents/updates/$(paymentId);
      let payment = getAfter(paymentPath).data;
      return resource.data.deleted == false &&
        resource.data.settled == false &&
        payment.type == 'Financeiro' &&
        payment.updatedAt == request.time &&
        payment.financialInstallmentId == installmentId &&
        request.resource.data.paidAmountCents ==
          resource.data.paidAmountCents + payment.amountCents &&
        oneIdAppended(
          resource.data.paymentIds,
          request.resource.data.paymentIds,
          paymentId
        ) &&
        request.resource.data.settled == payment.settlesInstallment &&
        request.resource.data.settledAt ==
          (payment.settlesInstallment ? payment.paidAt : null) &&
        request.resource.data.settledByPaymentId ==
          (payment.settlesInstallment ? paymentId : null) &&
        request.resource.data.settlementKind ==
          (
            payment.settlesInstallment
              ? (
                  payment.paymentKind == 'partial'
                    ? 'partial_rolled'
                    : 'full'
                )
              : null
          ) &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.updatedById == request.auth.uid &&
        request.resource.data.updatedBy == payment.updatedBy &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'paidAmountCents',
          'paymentIds',
          'settled',
          'settledAt',
          'settledByPaymentId',
          'settlementKind',
          'updatedAt',
          'updatedById',
          'updatedBy'
        ]);
    }

    function validInstallmentPaymentRemoval(installmentId) {
      let paymentId =
        resource.data.paymentIds[resource.data.paymentIds.size() - 1];
      let paymentPath = /databases/$(database)/documents/updates/$(paymentId);
      let payment = getAfter(paymentPath).data;
      return resource.data.deleted == false &&
        request.resource.data.deleted == false &&
        validId(paymentId) &&
        installmentId == deterministicInstallmentId(
          resource.data.agreementId,
          resource.data.sequence
        ) &&
        resource.data.paymentIds[resource.data.paymentIds.size() - 1] ==
          paymentId &&
        payment.type == 'Financeiro' &&
        payment.deleted == true &&
        payment.updatedAt == request.time &&
        payment.financialAgreementId == resource.data.agreementId &&
        payment.financialInstallmentId == installmentId &&
        payment.amountCents ==
          resource.data.paidAmountCents - request.resource.data.paidAmountCents &&
        request.resource.data.paidAmountCents >= 0 &&
        request.resource.data.paidAmountCents < resource.data.paidAmountCents &&
        oneIdRemoved(resource.data.paymentIds, request.resource.data.paymentIds) &&
        !(paymentId in request.resource.data.paymentIds) &&
        (resource.data.settled == false ||
          resource.data.settledByPaymentId == paymentId) &&
        request.resource.data.settled == false &&
        request.resource.data.settledAt == null &&
        request.resource.data.settledByPaymentId == null &&
        request.resource.data.settlementKind == null &&
        validUpdateAudit(request.resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'paidAmountCents',
          'paymentIds',
          'settled',
          'settledAt',
          'settledByPaymentId',
          'settlementKind',
          'updatedAt',
          'updatedById',
          'updatedBy'
        ]);
    }

    function validInstallmentDelete() {
      let agreementPath =
        /databases/$(database)/documents/financialAgreements/$(resource.data.agreementId);
      return resource.data.deleted == false &&
        resource.data.settled == false &&
        resource.data.paidAmountCents == 0 &&
        resource.data.paymentIds.size() == 0 &&
        request.resource.data.deleted == true &&
        request.resource.data.deletedAt == request.time &&
        request.resource.data.deletedById == request.auth.uid &&
        validString(request.resource.data.deletedBy, 1, 200) &&
        getAfter(agreementPath).data.deleted == true &&
        onlyDeletionAndAuditChanged() &&
        validUpdateAudit(request.resource.data);
    }

    function validInstallmentRestore() {
      let agreementPath =
        /databases/$(database)/documents/financialAgreements/$(resource.data.agreementId);
      return isAdmin() &&
        resource.data.deleted == true &&
        request.resource.data.deleted == false &&
        request.resource.data.deletedAt == null &&
        request.resource.data.deletedById == null &&
        request.resource.data.deletedBy == null &&
        getAfter(agreementPath).data.deleted == false &&
        onlyDeletionAndAuditChanged() &&
        validUpdateAudit(request.resource.data);
    }

    function validInstallmentClientSync() {
      return isAdmin() &&
        activeClientExists(request.resource.data.clientId) &&
        validUpdateAudit(request.resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'clientId',
          'updatedAt',
          'updatedById',
          'updatedBy'
        ]);
    }

    match /financialInstallments/{id} {
      allow read: if canReadFinancialResource();
      allow create: if isActive() && validInstallmentCreate(id);
      allow update: if isActive() &&
        id == deterministicInstallmentId(
          request.resource.data.agreementId,
          request.resource.data.sequence
        ) &&
        (
          validInstallmentPaymentAppend(id) ||
          validInstallmentPaymentRemoval(id) ||
          validInstallmentDelete() ||
          validInstallmentRestore() ||
          validInstallmentClientSync()
        );
      allow delete: if false;
    }

    // ------------------------------------------------------------------
    // Recebimentos canônicos em updates
    // ------------------------------------------------------------------

    function validPaymentReceiptShape(data) {
      return data.receiptMethod in [
          'cash',
          'pix',
          'bank_deposit',
          'card_machine',
          'other'
        ] &&
        (
          (data.receiptMethod == 'other' &&
            validString(data.receiptMethodOther, 1, 200)) ||
          (data.receiptMethod != 'other' &&
            data.receiptMethodOther == '')
        ) &&
        (
          (data.receiptMethod == 'cash' &&
            data.receiptAccountId == '' &&
            data.receiptAccountName == '') ||
          (data.receiptMethod != 'cash' &&
            validString(data.receiptAccountName, 1, 200) &&
            (data.receiptAccountId == '' || validId(data.receiptAccountId)))
        );
    }

    function validFinancialPayment(data) {
      return data.keys().size() == 31 &&
        !data.keys().hasAny(['deletedById']) &&
        data.type == 'Financeiro' &&
        validString(data.clientName, 1, 300) &&
        validString(data.clientCode, 0, 32) &&
        validString(data.description, 1, 8000) &&
        validCents(data.amountCents, false) &&
        data.paidAt is timestamp &&
        data.updateDate == data.paidAt &&
        validPaymentReceiptShape(data) &&
        validString(data.financialNote, 0, 2000) &&
        data.paymentKind in ['full', 'partial'] &&
        (
          (data.paymentKind == 'full' &&
            data.amountCents >= data.requiredInstallmentAmountCents) ||
          (data.paymentKind == 'partial' &&
            data.amountCents < data.requiredInstallmentAmountCents)
        ) &&
        validString(data.author, 1, 200) &&
        data.authorId == request.auth.uid &&
        data.createdAt == request.time &&
        data.updatedAt == request.time &&
        validString(data.updatedBy, 1, 200) &&
        data.deleted == false &&
        data.deletedAt == null &&
        data.deletedBy == null;
    }

    function validReferencedReceiptAccount(data) {
      let account = get(
        /databases/$(database)/documents/receivingAccounts/$(data.receiptAccountId)
      ).data;
      return account.deleted == false &&
        account.name == data.receiptAccountName;
    }

    function validReceiptAccountAtPayment(data) {
      return data.receiptMethod == 'cash' ||
        data.receiptAccountId == '' ||
        validReferencedReceiptAccount(data);
    }

    function validReferencedWageAtPayment(data, agreement) {
      let wage = get(
        /databases/$(database)/documents/minimumWages/$(data.minimumWageRateIdAtPayment)
      ).data;
      let correctedTarget =
        data.minimumWageCentsAtPayment * agreement.minimumWageMultiplier;
      return wage.deleted == false &&
        wage.amountCents == data.minimumWageCentsAtPayment &&
        wage.effectiveFrom <= data.paidAt &&
        data.agreementTargetCentsAtPayment >= agreement.originalAmountCents &&
        data.agreementTargetCentsAtPayment >= correctedTarget &&
        (
          data.agreementTargetCentsAtPayment ==
            agreement.originalAmountCents ||
          data.agreementTargetCentsAtPayment <= correctedTarget + 1
        );
    }

    function validWageAtPayment(data, agreement) {
      return (
        agreement.valueBasis == 'custom' &&
        data.minimumWageRateIdAtPayment == '' &&
        data.minimumWageCentsAtPayment == null &&
        data.agreementTargetCentsAtPayment == agreement.originalAmountCents
      ) || (
        agreement.valueBasis != 'custom' &&
        validReferencedWageAtPayment(data, agreement)
      );
    }

    function validPaymentSelectionAndAllocation(data, agreement, installment) {
      let pendingCents =
        data.agreementTargetCentsAtPayment - agreement.receivedAmountCents;
      let openInstallmentCount =
        agreement.installmentCount - agreement.settledInstallmentCount;
      let maximumPaymentCents =
        pendingCents -
          (openInstallmentCount > 1 ? openInstallmentCount - 1 : 0);
      return agreement.deleted == false &&
        agreement.settled == false &&
        agreement.clientId == data.clientId &&
        agreement.installmentCount is int &&
        agreement.installmentCount >= 1 &&
        agreement.installmentCount <= 60 &&
        agreement.receivedAmountCents is int &&
        agreement.receivedAmountCents >= 0 &&
        agreement.settledInstallmentCount is int &&
        agreement.settledInstallmentCount >= 0 &&
        agreement.settledInstallmentCount < agreement.installmentCount &&
        installment.deleted == false &&
        installment.settled == false &&
        installment.agreementId == data.financialAgreementId &&
        installment.clientId == data.clientId &&
        installment.installmentCount == agreement.installmentCount &&
        installment.sequence is int &&
        installment.sequence >= 1 &&
        installment.sequence <= agreement.installmentCount &&
        data.financialInstallmentId == deterministicInstallmentId(
          data.financialAgreementId,
          installment.sequence
        ) &&
        agreement.installmentIds[installment.sequence - 1] ==
          data.financialInstallmentId &&
        installment.baseAmountCents ==
          (
            installment.sequence == agreement.installmentCount
              ? agreement.finalInstallmentAmountCents
              : agreement.regularInstallmentAmountCents
          ) &&
        data.previousAgreementPaymentId == agreement.lastPaymentId &&
        pendingCents >= openInstallmentCount &&
        data.requiredInstallmentAmountCents is int &&
        data.requiredInstallmentAmountCents > 0 &&
        data.requiredInstallmentAmountCents <= pendingCents &&
        data.amountCents <= maximumPaymentCents &&
        data.settlesInstallment ==
          (openInstallmentCount > 1 || data.amountCents == pendingCents) &&
        data.closesAgreement ==
          (openInstallmentCount == 1 && data.amountCents == pendingCents);
    }

    function paymentLinkedAfter(paymentId, data) {
      let installmentPath =
        /databases/$(database)/documents/financialInstallments/$(data.financialInstallmentId);
      let afterInstallment = getAfter(installmentPath).data;
      let agreementPath =
        /databases/$(database)/documents/financialAgreements/$(data.financialAgreementId);
      let afterAgreement = getAfter(agreementPath).data;
      return afterAgreement.lastPaymentId == paymentId &&
        afterInstallment.paymentIds[afterInstallment.paymentIds.size() - 1] ==
          paymentId;
    }

    function paymentUnlinkedAfter(paymentId, data) {
      let installmentPath =
        /databases/$(database)/documents/financialInstallments/$(data.financialInstallmentId);
      let afterInstallment = getAfter(installmentPath).data;
      let agreementPath =
        /databases/$(database)/documents/financialAgreements/$(data.financialAgreementId);
      let afterAgreement = getAfter(agreementPath).data;
      return afterAgreement.lastPaymentId == data.previousAgreementPaymentId &&
        !(paymentId in afterInstallment.paymentIds);
    }

    function validFinancialPaymentCreate(paymentId) {
      let agreement = get(
        /databases/$(database)/documents/financialAgreements/$(request.resource.data.financialAgreementId)
      ).data;
      let installment = get(
        /databases/$(database)/documents/financialInstallments/$(request.resource.data.financialInstallmentId)
      ).data;
      let client = get(
        /databases/$(database)/documents/clients/$(request.resource.data.clientId)
      ).data;
      return validFinancialPayment(request.resource.data) &&
        request.resource.data.paidAt <= request.time + duration.value(2, 'm') &&
        (!client.keys().hasAny(['deleted']) || client.deleted != true) &&
        request.resource.data.clientName == client.name &&
        request.resource.data.clientCode ==
          (client.keys().hasAny(['code']) ? client.code : '') &&
        validPaymentSelectionAndAllocation(
          request.resource.data,
          agreement,
          installment
        ) &&
        validReceiptAccountAtPayment(request.resource.data) &&
        validWageAtPayment(request.resource.data, agreement) &&
        paymentLinkedAfter(
          paymentId,
          request.resource.data
        );
    }

    function validFinancialPaymentDelete(paymentId) {
      let installmentPath =
        /databases/$(database)/documents/financialInstallments/$(resource.data.financialInstallmentId);
      let agreementPath =
        /databases/$(database)/documents/financialAgreements/$(resource.data.financialAgreementId);
      let installment = get(installmentPath).data;
      let agreement = get(agreementPath).data;
      return (isAdmin() || resource.data.authorId == request.auth.uid) &&
        resource.data.deleted == false &&
        request.resource.data.deleted == true &&
        request.resource.data.deletedAt == request.time &&
        request.resource.data.deletedById == request.auth.uid &&
        request.resource.data.updatedAt == request.time &&
        validString(request.resource.data.deletedBy, 1, 200) &&
        validString(request.resource.data.updatedBy, 1, 200) &&
        onlyDeletionAndAuditChanged() &&
        installment.agreementId == resource.data.financialAgreementId &&
        installment.clientId == resource.data.clientId &&
        resource.data.financialInstallmentId ==
          deterministicInstallmentId(
            resource.data.financialAgreementId,
            installment.sequence
          ) &&
        installment.deleted == false &&
        installment.paymentIds.size() >= 1 &&
        installment.paymentIds[installment.paymentIds.size() - 1] ==
          paymentId &&
        (installment.settled == false ||
          installment.settledByPaymentId == paymentId) &&
        agreement.deleted == false &&
        agreement.lastPaymentId == paymentId &&
        (agreement.settled == false ||
          (agreement.settledByPaymentId == paymentId &&
            resource.data.closesAgreement == true)) &&
        paymentUnlinkedAfter(
          paymentId,
          resource.data
        );
    }

    function validFinancialPaymentRestore(paymentId) {
      let installmentPath =
        /databases/$(database)/documents/financialInstallments/$(resource.data.financialInstallmentId);
      let agreementPath =
        /databases/$(database)/documents/financialAgreements/$(resource.data.financialAgreementId);
      let installment = get(installmentPath).data;
      let agreement = get(agreementPath).data;
      return isAdmin() &&
        resource.data.deleted == true &&
        request.resource.data.deleted == false &&
        request.resource.data.deletedAt == null &&
        request.resource.data.deletedById == null &&
        request.resource.data.deletedBy == null &&
        request.resource.data.updatedAt == request.time &&
        validString(request.resource.data.updatedBy, 1, 200) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'deleted',
          'deletedAt',
          'deletedById',
          'deletedBy',
          'updatedAt',
          'updatedBy'
        ]) &&
        validPaymentSelectionAndAllocation(
          request.resource.data,
          agreement,
          installment
        ) &&
        paymentLinkedAfter(
          paymentId,
          request.resource.data
        );
    }

    function validFinancialPaymentClientSync() {
      let client = get(
        /databases/$(database)/documents/clients/$(request.resource.data.clientId)
      ).data;
      return isAdmin() &&
        activeClientExists(request.resource.data.clientId) &&
        request.resource.data.clientName == client.name &&
        request.resource.data.clientCode ==
          (client.keys().hasAny(['code']) ? client.code : '') &&
        request.resource.data.updatedAt == request.time &&
        validString(request.resource.data.updatedBy, 1, 200) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'clientId',
          'clientName',
          'clientCode',
          'updatedAt',
          'updatedBy'
        ]);
    }

    function validFinancialPaymentUpdate(paymentId) {
      return resource.data.type == 'Financeiro' &&
        request.resource.data.type == 'Financeiro' &&
        (
          validFinancialPaymentDelete(paymentId) ||
          validFinancialPaymentRestore(paymentId) ||
          validFinancialPaymentClientSync()
        );
    }

    // ------------------------------------------------------------------
    // Modelos, documentos jurídicos e partes rápidas
    // ------------------------------------------------------------------

    function validLegalContent(data) {
      return validString(data.contentJson, 2, 550000) &&
        validString(data.plainText, 0, 80000) &&
        validString(data.stylesJson, 2, 25000) &&
        validString(data.pageSettingsJson, 2, 6000) &&
        data.version is int &&
        data.version >= 1 &&
        data.version <= 1000000 &&
        data.createdAt is timestamp &&
        validId(data.createdById) &&
        validString(data.createdBy, 1, 200) &&
        data.updatedAt is timestamp &&
        validId(data.updatedById) &&
        validString(data.updatedBy, 1, 200) &&
        validDeletionState(data);
    }

    function legalIdentityUnchanged() {
      return request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.createdById == resource.data.createdById &&
        request.resource.data.createdBy == resource.data.createdBy;
    }

    function validLegalDeletionUpdate() {
      return (
          resource.data.deleted == false &&
          request.resource.data.deleted == false &&
          request.resource.data.deletedAt == resource.data.deletedAt &&
          request.resource.data.deletedById == resource.data.deletedById &&
          request.resource.data.deletedBy == resource.data.deletedBy
        ) || (
          onlyDeletionAndAuditChanged() &&
          resource.data.deleted == false &&
          request.resource.data.deleted == true &&
          request.resource.data.deletedAt == request.time &&
          request.resource.data.deletedById == request.auth.uid
        ) || (
          onlyDeletionAndAuditChanged() &&
          resource.data.deleted == true &&
          request.resource.data.deleted == false &&
          request.resource.data.deletedAt == null &&
          request.resource.data.deletedById == null &&
          request.resource.data.deletedBy == null
        );
    }

    function canManageOwnedLegalResource() {
      return isAdmin() ||
        (isActive() && resource.data.createdById == request.auth.uid);
    }

    function canReadOwnedLegalResource() {
      return isAdmin() ||
        (isActive() &&
          (resource.data.deleted == false || resource.data.createdById == request.auth.uid));
    }

    function canReadOwnedLegalData(data) {
      return isAdmin() ||
        (isActive() && (data.deleted == false || data.createdById == request.auth.uid));
    }

    function canManageOwnedLegalData(data) {
      return isAdmin() ||
        (isActive() && data.createdById == request.auth.uid);
    }

    function validLegalVersionTransition(entityId, versionCollection) {
      let beforeVersion = resource.data.version;
      let afterVersion = request.resource.data.version;
      return afterVersion == beforeVersion ||
        (
          afterVersion == beforeVersion + 1 &&
          getAfter(
            /databases/$(database)/documents/$(versionCollection)/$(entityId + '_' + string(afterVersion))
          ).data.version == afterVersion
        ) ||
        (
          afterVersion == beforeVersion + 2 &&
          getAfter(
            /databases/$(database)/documents/$(versionCollection)/$(entityId + '_' + string(beforeVersion + 1))
          ).data.version == beforeVersion + 1 &&
          getAfter(
            /databases/$(database)/documents/$(versionCollection)/$(entityId + '_' + string(afterVersion))
          ).data.version == afterVersion
        );
    }

    function validLegalFolder(data) {
      return data.keys().hasAll([
          'name',
          'nameLower',
          'createdAt',
          'createdById',
          'createdBy',
          'updatedAt',
          'updatedById',
          'updatedBy',
          'deleted',
          'deletedAt',
          'deletedById',
          'deletedBy'
        ]) &&
        data.keys().hasOnly([
          'name',
          'nameLower',
          'createdAt',
          'createdById',
          'createdBy',
          'updatedAt',
          'updatedById',
          'updatedBy',
          'deleted',
          'deletedAt',
          'deletedById',
          'deletedBy'
        ]) &&
        validString(data.name, 1, 200) &&
        validString(data.nameLower, 1, 200) &&
        data.createdAt is timestamp &&
        validId(data.createdById) &&
        validString(data.createdBy, 1, 200) &&
        data.updatedAt is timestamp &&
        validId(data.updatedById) &&
        validString(data.updatedBy, 1, 200) &&
        validDeletionState(data);
    }

    function validLegalFolderCreate() {
      return validLegalFolder(request.resource.data) &&
        validCreateAudit(request.resource.data) &&
        request.resource.data.createdById == request.auth.uid &&
        request.resource.data.deleted == false;
    }

    function validLegalFolderUpdate() {
      return validLegalFolder(request.resource.data) &&
        canManageOwnedLegalResource() &&
        legalIdentityUnchanged() &&
        validLegalDeletionUpdate() &&
        validUpdateAudit(request.resource.data);
    }

    match /legalTemplateFolders/{id} {
      allow read: if canReadOwnedLegalResource();
      allow create: if isActive() && validLegalFolderCreate();
      allow update: if isActive() && validLegalFolderUpdate();
      allow delete: if false;
    }

    function validLegalTemplate(data) {
      return data.keys().hasAll([
          'name',
          'nameLower',
          'folderId',
          'duplicatedFromTemplateId',
          'contentJson',
          'plainText',
          'stylesJson',
          'pageSettingsJson',
          'version',
          'createdAt',
          'createdById',
          'createdBy',
          'updatedAt',
          'updatedById',
          'updatedBy',
          'deleted',
          'deletedAt',
          'deletedById',
          'deletedBy'
        ]) &&
        data.keys().hasOnly([
          'name',
          'nameLower',
          'folderId',
          'duplicatedFromTemplateId',
          'contentJson',
          'plainText',
          'stylesJson',
          'pageSettingsJson',
          'version',
          'createdAt',
          'createdById',
          'createdBy',
          'updatedAt',
          'updatedById',
          'updatedBy',
          'deleted',
          'deletedAt',
          'deletedById',
          'deletedBy'
        ]) &&
        validString(data.name, 1, 200) &&
        validString(data.nameLower, 1, 200) &&
        validNullableId(data.folderId) &&
        validNullableId(data.duplicatedFromTemplateId) &&
        validLegalContent(data);
    }

    function validLegalTemplateDuplication(data) {
      return (
          data.duplicatedFromTemplateId == null &&
          data.plainText == ''
        ) || (
          data.duplicatedFromTemplateId != null &&
          exists(
            /databases/$(database)/documents/legalTemplates/$(data.duplicatedFromTemplateId)
          ) &&
          get(
            /databases/$(database)/documents/legalTemplates/$(data.duplicatedFromTemplateId)
          ).data.deleted == false &&
          canManageOwnedLegalData(
            get(
              /databases/$(database)/documents/legalTemplates/$(data.duplicatedFromTemplateId)
            ).data
          ) &&
          data.contentJson == get(
            /databases/$(database)/documents/legalTemplates/$(data.duplicatedFromTemplateId)
          ).data.contentJson &&
          data.plainText == get(
            /databases/$(database)/documents/legalTemplates/$(data.duplicatedFromTemplateId)
          ).data.plainText &&
          data.stylesJson == get(
            /databases/$(database)/documents/legalTemplates/$(data.duplicatedFromTemplateId)
          ).data.stylesJson &&
          data.pageSettingsJson == get(
            /databases/$(database)/documents/legalTemplates/$(data.duplicatedFromTemplateId)
          ).data.pageSettingsJson
        );
    }

    function validLegalTemplateCreate(templateId) {
      let data = request.resource.data;
      let version = getAfter(
        /databases/$(database)/documents/legalTemplateVersions/$(templateId + '_1')
      ).data;
      return validLegalTemplate(data) &&
        validCreateAudit(data) &&
        data.createdById == request.auth.uid &&
        data.version == 1 &&
        data.deleted == false &&
        validLegalTemplateDuplication(data) &&
        version.entityId == templateId &&
        version.version == 1;
    }

    function validLegalTemplateUpdate(templateId) {
      return validLegalTemplate(request.resource.data) &&
        canManageOwnedLegalResource() &&
        legalIdentityUnchanged() &&
        request.resource.data.duplicatedFromTemplateId == resource.data.duplicatedFromTemplateId &&
        validLegalDeletionUpdate() &&
        validUpdateAudit(request.resource.data) &&
        validLegalVersionTransition(templateId, 'legalTemplateVersions');
    }

    match /legalTemplates/{id} {
      allow read: if canReadOwnedLegalResource();
      allow create: if isActive() && validLegalTemplateCreate(id);
      allow update: if isActive() && validLegalTemplateUpdate(id);
      allow delete: if false;
    }

    function validLegalDocument(data) {
      return data.keys().hasAll([
          'name',
          'nameLower',
          'clientId',
          'clientName',
          'sourceTemplateId',
          'sourceTemplateName',
          'sourceTemplateVersion',
          'contentJson',
          'plainText',
          'stylesJson',
          'pageSettingsJson',
          'version',
          'createdAt',
          'createdById',
          'createdBy',
          'updatedAt',
          'updatedById',
          'updatedBy',
          'deleted',
          'deletedAt',
          'deletedById',
          'deletedBy'
        ]) &&
        data.keys().hasOnly([
          'name',
          'nameLower',
          'clientId',
          'clientName',
          'sourceTemplateId',
          'sourceTemplateName',
          'sourceTemplateVersion',
          'contentJson',
          'plainText',
          'stylesJson',
          'pageSettingsJson',
          'version',
          'createdAt',
          'createdById',
          'createdBy',
          'updatedAt',
          'updatedById',
          'updatedBy',
          'deleted',
          'deletedAt',
          'deletedById',
          'deletedBy'
        ]) &&
        validString(data.name, 1, 200) &&
        validString(data.nameLower, 1, 200) &&
        validId(data.clientId) &&
        validString(data.clientName, 1, 300) &&
        validNullableId(data.sourceTemplateId) &&
        validString(data.sourceTemplateName, 0, 200) &&
        (data.sourceTemplateVersion == null ||
          (data.sourceTemplateVersion is int && data.sourceTemplateVersion >= 1)) &&
        validLegalContent(data);
    }

    function validLegalDocumentCreate(documentId) {
      let data = request.resource.data;
      let version = getAfter(
        /databases/$(database)/documents/legalDocumentVersions/$(documentId + '_1')
      ).data;
      return validLegalDocument(data) &&
        validCreateAudit(data) &&
        data.createdById == request.auth.uid &&
        data.version == 1 &&
        data.deleted == false &&
        activeClientExists(data.clientId) &&
        validLegalDocumentSource(data) &&
        version.entityId == documentId &&
        version.version == 1;
    }

    function validLegalDocumentSource(data) {
      let sourceVersionId = data.sourceTemplateId == null || data.sourceTemplateVersion == null
        ? ''
        : data.sourceTemplateId + '_' + string(data.sourceTemplateVersion);
      return (
          data.sourceTemplateId == null &&
          data.sourceTemplateName == '' &&
          data.sourceTemplateVersion == null
        ) || (
          data.sourceTemplateId != null &&
          data.sourceTemplateVersion != null &&
          exists(/databases/$(database)/documents/legalTemplates/$(data.sourceTemplateId)) &&
          get(/databases/$(database)/documents/legalTemplates/$(data.sourceTemplateId)).data.deleted == false &&
          exists(/databases/$(database)/documents/legalTemplateVersions/$(sourceVersionId)) &&
          get(/databases/$(database)/documents/legalTemplateVersions/$(sourceVersionId)).data.entityId == data.sourceTemplateId &&
          get(/databases/$(database)/documents/legalTemplateVersions/$(sourceVersionId)).data.version == data.sourceTemplateVersion &&
          get(/databases/$(database)/documents/legalTemplateVersions/$(sourceVersionId)).data.name == data.sourceTemplateName
        );
    }

    function validLegalDocumentUpdate(documentId) {
      return validLegalDocument(request.resource.data) &&
        legalIdentityUnchanged() &&
        request.resource.data.clientId == resource.data.clientId &&
        request.resource.data.clientName == resource.data.clientName &&
        request.resource.data.sourceTemplateId == resource.data.sourceTemplateId &&
        request.resource.data.sourceTemplateName == resource.data.sourceTemplateName &&
        request.resource.data.sourceTemplateVersion == resource.data.sourceTemplateVersion &&
        validLegalDeletionUpdate() &&
        validUpdateAudit(request.resource.data) &&
        validLegalVersionTransition(documentId, 'legalDocumentVersions');
    }

    match /legalDocuments/{id} {
      allow read: if isActive();
      allow create: if isActive() && validLegalDocumentCreate(id);
      allow update: if isActive() && validLegalDocumentUpdate(id);
      allow delete: if false;
    }

    function validLegalQuickPart(data) {
      return data.keys().hasAll([
          'title',
          'titleLower',
          'searchText',
          'duplicatedFromQuickPartId',
          'contentJson',
          'plainText',
          'stylesJson',
          'pageSettingsJson',
          'version',
          'createdAt',
          'createdById',
          'createdBy',
          'updatedAt',
          'updatedById',
          'updatedBy',
          'deleted',
          'deletedAt',
          'deletedById',
          'deletedBy'
        ]) &&
        data.keys().hasOnly([
          'title',
          'titleLower',
          'searchText',
          'duplicatedFromQuickPartId',
          'contentJson',
          'plainText',
          'stylesJson',
          'pageSettingsJson',
          'version',
          'createdAt',
          'createdById',
          'createdBy',
          'updatedAt',
          'updatedById',
          'updatedBy',
          'deleted',
          'deletedAt',
          'deletedById',
          'deletedBy'
        ]) &&
        validString(data.title, 1, 200) &&
        validString(data.titleLower, 1, 200) &&
        validString(data.searchText, 0, 80000) &&
        validNullableId(data.duplicatedFromQuickPartId) &&
        validLegalContent(data);
    }

    function validLegalQuickPartDuplication(data) {
      return (
          data.duplicatedFromQuickPartId == null &&
          data.plainText == ''
        ) || (
          data.duplicatedFromQuickPartId != null &&
          exists(
            /databases/$(database)/documents/legalQuickParts/$(data.duplicatedFromQuickPartId)
          ) &&
          get(
            /databases/$(database)/documents/legalQuickParts/$(data.duplicatedFromQuickPartId)
          ).data.deleted == false &&
          canManageOwnedLegalData(
            get(
              /databases/$(database)/documents/legalQuickParts/$(data.duplicatedFromQuickPartId)
            ).data
          ) &&
          data.contentJson == get(
            /databases/$(database)/documents/legalQuickParts/$(data.duplicatedFromQuickPartId)
          ).data.contentJson &&
          data.plainText == get(
            /databases/$(database)/documents/legalQuickParts/$(data.duplicatedFromQuickPartId)
          ).data.plainText &&
          data.stylesJson == get(
            /databases/$(database)/documents/legalQuickParts/$(data.duplicatedFromQuickPartId)
          ).data.stylesJson &&
          data.pageSettingsJson == get(
            /databases/$(database)/documents/legalQuickParts/$(data.duplicatedFromQuickPartId)
          ).data.pageSettingsJson
        );
    }

    function validLegalQuickPartCreate(partId) {
      let data = request.resource.data;
      let version = getAfter(
        /databases/$(database)/documents/legalQuickPartVersions/$(partId + '_1')
      ).data;
      return validLegalQuickPart(data) &&
        validCreateAudit(data) &&
        data.createdById == request.auth.uid &&
        data.version == 1 &&
        data.deleted == false &&
        validLegalQuickPartDuplication(data) &&
        version.entityId == partId &&
        version.version == 1;
    }

    function validLegalQuickPartUpdate(partId) {
      return validLegalQuickPart(request.resource.data) &&
        canManageOwnedLegalResource() &&
        legalIdentityUnchanged() &&
        request.resource.data.duplicatedFromQuickPartId == resource.data.duplicatedFromQuickPartId &&
        validLegalDeletionUpdate() &&
        validUpdateAudit(request.resource.data) &&
        validLegalVersionTransition(partId, 'legalQuickPartVersions');
    }

    match /legalQuickParts/{id} {
      allow read: if canReadOwnedLegalResource();
      allow create: if isActive() && validLegalQuickPartCreate(id);
      allow update: if isActive() && validLegalQuickPartUpdate(id);
      allow delete: if false;
    }

    function validLegalVersion(data, expectedType) {
      return data.keys().hasAll([
          'entityId',
          'entityType',
          'version',
          'name',
          'contentJson',
          'plainText',
          'stylesJson',
          'pageSettingsJson',
          'reason',
          'createdAt',
          'createdById',
          'createdBy'
        ]) &&
        data.keys().hasOnly([
          'entityId',
          'entityType',
          'version',
          'name',
          'contentJson',
          'plainText',
          'stylesJson',
          'pageSettingsJson',
          'reason',
          'createdAt',
          'createdById',
          'createdBy'
        ]) &&
        validId(data.entityId) &&
        data.entityType == expectedType &&
        data.version is int &&
        data.version >= 1 &&
        data.version <= 1000000 &&
        validString(data.name, 1, 200) &&
        validString(data.contentJson, 2, 550000) &&
        validString(data.plainText, 0, 80000) &&
        validString(data.stylesJson, 2, 25000) &&
        validString(data.pageSettingsJson, 2, 6000) &&
        data.reason in ['initial', 'explicit', 'before_restore', 'restored'] &&
        data.createdAt == request.time &&
        data.createdById == request.auth.uid &&
        validString(data.createdBy, 1, 200);
    }

    function versionMatchesTemplate(data, parent) {
      return data.name == parent.name &&
        data.contentJson == parent.contentJson &&
        data.plainText == parent.plainText &&
        data.stylesJson == parent.stylesJson &&
        data.pageSettingsJson == parent.pageSettingsJson;
    }

    function versionMatchesDocument(data, parent) {
      return data.name == parent.name &&
        data.contentJson == parent.contentJson &&
        data.plainText == parent.plainText &&
        data.stylesJson == parent.stylesJson &&
        data.pageSettingsJson == parent.pageSettingsJson;
    }

    function versionMatchesQuickPart(data, parent) {
      return data.name == parent.title &&
        data.contentJson == parent.contentJson &&
        data.plainText == parent.plainText &&
        data.stylesJson == parent.stylesJson &&
        data.pageSettingsJson == parent.pageSettingsJson;
    }

    function validTemplateVersionCreate(versionDocId) {
      let data = request.resource.data;
      let parent = getAfter(
        /databases/$(database)/documents/legalTemplates/$(data.entityId)
      ).data;
      return validLegalVersion(data, 'template') &&
        versionDocId == data.entityId + '_' + string(data.version) &&
        canManageOwnedLegalData(parent) &&
        (
          (data.version == parent.version && versionMatchesTemplate(data, parent)) ||
          (
            data.reason == 'before_restore' &&
            exists(/databases/$(database)/documents/legalTemplates/$(data.entityId)) &&
            data.version == get(
              /databases/$(database)/documents/legalTemplates/$(data.entityId)
            ).data.version + 1 &&
            parent.version == get(
              /databases/$(database)/documents/legalTemplates/$(data.entityId)
            ).data.version + 2 &&
            versionMatchesTemplate(
              data,
              get(/databases/$(database)/documents/legalTemplates/$(data.entityId)).data
            )
          )
        );
    }

    function validDocumentVersionCreate(versionDocId) {
      let data = request.resource.data;
      let parent = getAfter(
        /databases/$(database)/documents/legalDocuments/$(data.entityId)
      ).data;
      return validLegalVersion(data, 'document') &&
        versionDocId == data.entityId + '_' + string(data.version) &&
        isActive() &&
        (
          (data.version == parent.version && versionMatchesDocument(data, parent)) ||
          (
            data.reason == 'before_restore' &&
            exists(/databases/$(database)/documents/legalDocuments/$(data.entityId)) &&
            data.version == get(
              /databases/$(database)/documents/legalDocuments/$(data.entityId)
            ).data.version + 1 &&
            parent.version == get(
              /databases/$(database)/documents/legalDocuments/$(data.entityId)
            ).data.version + 2 &&
            versionMatchesDocument(
              data,
              get(/databases/$(database)/documents/legalDocuments/$(data.entityId)).data
            )
          )
        );
    }

    function validQuickPartVersionCreate(versionDocId) {
      let data = request.resource.data;
      let parent = getAfter(
        /databases/$(database)/documents/legalQuickParts/$(data.entityId)
      ).data;
      return validLegalVersion(data, 'quickPart') &&
        versionDocId == data.entityId + '_' + string(data.version) &&
        canManageOwnedLegalData(parent) &&
        (
          (data.version == parent.version && versionMatchesQuickPart(data, parent)) ||
          (
            data.reason == 'before_restore' &&
            exists(/databases/$(database)/documents/legalQuickParts/$(data.entityId)) &&
            data.version == get(
              /databases/$(database)/documents/legalQuickParts/$(data.entityId)
            ).data.version + 1 &&
            parent.version == get(
              /databases/$(database)/documents/legalQuickParts/$(data.entityId)
            ).data.version + 2 &&
            versionMatchesQuickPart(
              data,
              get(/databases/$(database)/documents/legalQuickParts/$(data.entityId)).data
            )
          )
        );
    }

    match /legalTemplateVersions/{id} {
      allow read: if isActive() &&
        exists(/databases/$(database)/documents/legalTemplates/$(resource.data.entityId)) &&
        canReadOwnedLegalData(
          get(/databases/$(database)/documents/legalTemplates/$(resource.data.entityId)).data
        );
      allow create: if isActive() && validTemplateVersionCreate(id);
      allow update, delete: if false;
    }

    match /legalDocumentVersions/{id} {
      allow read: if isActive();
      allow create: if isActive() && validDocumentVersionCreate(id);
      allow update, delete: if false;
    }

    match /legalQuickPartVersions/{id} {
      allow read: if isActive() &&
        exists(/databases/$(database)/documents/legalQuickParts/$(resource.data.entityId)) &&
        canReadOwnedLegalData(
          get(/databases/$(database)/documents/legalQuickParts/$(resource.data.entityId)).data
        );
      allow create: if isActive() && validQuickPartVersionCreate(id);
      allow update, delete: if false;
    }

    // Perfis de usuário: leitura por usuários ativos (dropdown de responsáveis).
    // O próprio usuário altera somente suas preferências de exibição.
    match /users/{uid} {
      allow read: if isActive();
      allow create: if isAdmin() || (isBootstrapAdmin() && request.auth.uid == uid);
      allow update: if isAdmin() || (
        isActive() &&
        request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'operationPendingItemIds',
          'attendanceQuickTexts'
        ]) &&
        (!request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['operationPendingItemIds']) ||
          (request.resource.data.operationPendingItemIds is map &&
            request.resource.data.operationPendingItemIds.size() <= 50)) &&
        (!request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['attendanceQuickTexts']) ||
          (request.resource.data.attendanceQuickTexts is list &&
            request.resource.data.attendanceQuickTexts.size() <= 20))
      );
      allow delete: if false;
    }

    // Configurações: leitura para ativos, escrita só admin.
    match /clientTypes/{id} {
      allow read: if isActive();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /messageTemplates/{id} {
      allow read: if isActive();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // Dados operacionais: usuários ativos leem, criam e atualizam.
    // Delete físico é bloqueado para todos; remoções usam soft delete auditável.
    match /clients/{id} {
      allow read, create, update: if isActive();
      allow delete: if false;
    }

    match /caseFiles/{id} {
      allow read, create, update: if isActive();
      allow delete: if false;
    }

    match /updates/{id} {
      allow read: if isActive();
      allow create: if isActive() &&
        (
          request.resource.data.type != 'Financeiro' ||
          validFinancialPaymentCreate(id)
        );
      allow update: if isActive() &&
        (
          (resource.data.type != 'Financeiro' &&
            request.resource.data.type != 'Financeiro') ||
          validFinancialPaymentUpdate(id)
        );
      allow delete: if false;
    }

    match /processes/{id} {
      allow read, create, update: if isActive();
      allow delete: if false;
    }

    match /clientGroups/{id} {
      allow read, create, update: if isActive();
      allow delete: if false;
    }

    // Decisões e auditoria de possíveis duplicatas são exclusivas do administrador bootstrap.
    match /duplicateResolutions/{id} {
      allow read, create, update: if isBootstrapAdmin();
      allow delete: if false;
    }

    // Qualquer outra coleção: bloqueada.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
